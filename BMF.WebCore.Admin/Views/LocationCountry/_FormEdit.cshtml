@model Country
@{
    Layout = null;
}
@{ await Html.RenderPartialAsync(FixedTerms.System_PartialViewPath_AdminFeedbackPV); }
@if (ViewData["PVErrorDie"] == null || (ViewData["PVErrorDie"] != null && !(bool)ViewData["PVErrorDie"]))
{
    if (Model != null)
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ID)
        @Html.HiddenFor(model => model.RowVersion)
        <div class="form-group">
            @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label" })<span class="text-danger">*</span>
            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control", @required = "required", @maxlength = "50" } })
            @Html.ValidationMessageFor(model => model.Name, "")
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.Demonym, htmlAttributes: new { @class = "control-label" })<span class="text-danger">*</span>
            @Html.EditorFor(model => model.Demonym, new { htmlAttributes = new { @class = "form-control", @required = "required", @maxlength = "50" } })
            @Html.ValidationMessageFor(model => model.Demonym, "")
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.AlphaCode_2, htmlAttributes: new { @class = "control-label" })<span class="text-danger">*</span>
                    @Html.EditorFor(model => model.AlphaCode_2, new { htmlAttributes = new { @class = "form-control", @required = "required", @maxlength = "2" } })
                    @Html.ValidationMessageFor(model => model.AlphaCode_2, "")
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.AlphaCode_3, htmlAttributes: new { @class = "control-label" })<span class="text-danger">*</span>
                    @Html.EditorFor(model => model.AlphaCode_3, new { htmlAttributes = new { @class = "form-control", @required = "required", @maxlength = "3" } })
                    @Html.ValidationMessageFor(model => model.AlphaCode_3, "")
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.NumericCode, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.NumericCode, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.NumericCode, "")
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.CallingCode, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.CallingCode, new { htmlAttributes = new { @class = "form-control", @maxlength = "50" } })
                    @Html.ValidationMessageFor(model => model.CallingCode, "")
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.Region, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.Region, new { htmlAttributes = new { @class = "form-control", @maxlength = "50" } })
                    @Html.ValidationMessageFor(model => model.Region, "")
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.SubRegion, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.SubRegion, new { htmlAttributes = new { @class = "form-control", @maxlength = "50" } })
                    @Html.ValidationMessageFor(model => model.SubRegion, "")
                </div>
            </div>
        </div>
        <div class="form-group clearfix">
            @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label" })<span class="text-danger">*</span>
            <div class="icheck-primary d--inline">
                @Html.RadioButtonFor(m => m.IsActive, true, new { id = "IsActive_T" })
                <label for="IsActive_T">Yes</label>
            </div>
            <div class="icheck-primary d--inline">
                @Html.RadioButtonFor(m => m.IsActive, false, new { id = "IsActive_F" })
                <label for="IsActive_F">No</label>
            </div>
            @Html.ValidationMessageFor(model => model.IsActive, "")
        </div>
    }
}