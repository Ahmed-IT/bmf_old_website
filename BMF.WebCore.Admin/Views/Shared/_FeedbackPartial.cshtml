@if (ViewData["ErrorID"] != null)
{
    <div class="alert alert-danger alert-dismissible-">
        @if ((bool)ViewData["ErrorDispose"])
        {
            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
        }
        <h5><i class='icon fas fa-ban'></i>@Html.Raw(ViewData["ErrorTitle"])</h5>
        @if (!string.IsNullOrWhiteSpace((string)ViewData["ErrorMsg"]))
        {
            @Html.Raw(ViewData["ErrorMsg"])
        }
        <p>(Reference error code #@ViewData["ErrorID"])</p>
    </div>
}
