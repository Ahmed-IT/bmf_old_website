@if (ViewData["PVErrorID"] != null)
{
    <div class="alert alert-danger alert-dismissible-">
        @if ((bool)ViewData["PVErrorDispose"])
        {
            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
        }
        <h5><i class='icon fas fa-ban'></i>@Html.Raw(ViewData["PVErrorTitle"])</h5>
        @if (!string.IsNullOrWhiteSpace((string)ViewData["PVErrorMsg"]))
        {
            @Html.Raw(ViewData["PVErrorMsg"])
        }
        <p>(Reference error code #@ViewData["PVErrorID"])</p>
    </div>
}
