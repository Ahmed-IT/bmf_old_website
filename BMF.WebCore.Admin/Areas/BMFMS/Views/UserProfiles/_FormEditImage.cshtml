@model M_UserProfile
@{
    Layout = null;
}
@{ await Html.RenderPartialAsync(FixedTerms.System_PartialViewPath_AdminFeedbackPV); }
@if (ViewData["PVErrorDie"] == null || (ViewData["PVErrorDie"] != null && !(bool)ViewData["PVErrorDie"]))
{
    if (Model != null)
    {
        <div class="modal-body">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ID)
            @Html.HiddenFor(model => model.RowVersion)
            <table class="table table-striped table-hover table-bordered table-sm">
                <tr>
                    <th>@Html.LabelFor(model => model.FullName)</th>
                    <td>@Model.FullName</td>
                </tr>
                <tr>
                    <th>@Html.LabelFor(model => model.CPR)</th>
                    <td>@Model.CPR</td>
                </tr>
                <tr>
                    <th>@Html.LabelFor(model => model.Mobile_Number)</th>
                    <td>@Model.Mobile_Number</td>
                </tr>
            </table>
            <hr />
            <h3>Profile Image</h3>
            <input id="ImageUpload" name="ImageUpload" type="file">
        </div>
        <div class="modal-footer justify-content-between">
            <button type="button" class="btn btn-default" data-dismiss="modal"><i class="mr-1 fas fa-times"></i>Close</button>
        </div>
        <script id="image-upload">
            var URL_Image_Overview = ["@Model.Photo_URL "],
                Data_Image_Overview = [{ downloadUrl: "@Model.Photo_URL", key: @Model.ID, caption: "@Model.FullName" }];
            $("#ImageUpload").fileinput({
                theme: 'fas',
                required: true,
                showDrag: false,
                showRemove: false,
                overwriteInitial: true,
                initialPreview: URL_Image_Overview,
                initialPreviewAsData: true,
                minFileCount: 1,
                maxFileCount: 1,
                validateInitialCount: true,
                maxFileSize: 8000,
                allowedFileExtensions: ["jpeg", "jpg", "png"],
                initialPreviewConfig: Data_Image_Overview,
                uploadUrl: '@Url.Action("UploadImage", new { Model.ID })',
                //deleteUrl: '@Url.Action("DeleteImage", new { Model.ID })',
            });

            var getFileSize = function (url) {
                var req = $.ajax({
                    type: "HEAD",
                    url: url,
                    success: function () {
                        return (req.getResponseHeader("Content-Length") * 1048576);
                    }
                });
            }
        </script>
    }
}