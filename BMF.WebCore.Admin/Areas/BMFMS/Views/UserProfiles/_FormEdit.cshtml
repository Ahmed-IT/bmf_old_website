@model M_UserProfile
@{
    Layout = null;
}
@{ await Html.RenderPartialAsync(FixedTerms.System_PartialViewPath_AdminFeedbackPV); }
@if (ViewData["PVErrorDie"] == null || (ViewData["PVErrorDie"] != null && !(bool)ViewData["PVErrorDie"]))
{
    if (Model != null)
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ID)
        @Html.HiddenFor(model => model.RowVersion)

        <div class="form-group">
            @Html.LabelFor(model => model.ID_Nationality, htmlAttributes: new { @class = "control-label" })
            @Html.DropDownListFor(model => model.ID_Nationality, null, new { @class = "form-control select2-edit", @style = "width:100%;", @data_placeholder = "Select nationality ...", @data_allow_clear = "true" })
            @Html.ValidationMessageFor(model => model.ID_Nationality, "")
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.FullName, htmlAttributes: new { @class = "control-label" })<span class="text-danger">*</span>
            @Html.EditorFor(model => model.FullName, new { htmlAttributes = new { @class = "form-control", @required = "required", @maxlength = "60" } })
            @Html.ValidationMessageFor(model => model.FullName, "")
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.CPR, htmlAttributes: new { @class = "control-label" })
            @Html.EditorFor(model => model.CPR, new { htmlAttributes = new { @class = "form-control", @maxlength = "60" } })
            @Html.ValidationMessageFor(model => model.CPR, "")
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.DateOfBirth, htmlAttributes: new { @class = "control-label" })<span class="text-danger">*</span>
            <div class="input-group date" id="DateOfBirth_Edit" data-target-input="nearest">
                @Html.TextBox($"{nameof(Model.DateOfBirth)}", Model.Display_DateOfBirth, new { @class = "form-control datetimepicker-input datetimepicker-edit", @maxlength = "25", @autocomplete = "off", @data_toggle = "datetimepicker", @data_target = "#DateOfBirth_Edit" })
                <div class="input-group-append" data-target="#DateOfBirth_Edit" data-toggle="datetimepicker">
                    <div class="input-group-text"><i class="far fa-calendar-alt"></i></div>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.DateOfBirth, "")
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.Mobile_Number, htmlAttributes: new { @class = "control-label" })
            @Html.EditorFor(model => model.Mobile_Number, new { htmlAttributes = new { @class = "form-control", @maxlength = "60" } })
            @Html.ValidationMessageFor(model => model.Mobile_Number, "")
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.Full_Address, htmlAttributes: new { @class = "control-label" })
            @Html.EditorFor(model => model.Full_Address, new { htmlAttributes = new { @class = "form-control", @maxlength = "120" } })
            @Html.ValidationMessageFor(model => model.Full_Address, "")
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.Blood_Group, htmlAttributes: new { @class = "control-label" })
            @Html.EditorFor(model => model.Blood_Group, new { htmlAttributes = new { @class = "form-control", @maxlength = "10" } })
            @Html.ValidationMessageFor(model => model.Blood_Group, "")
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.Place_Of_Birth, htmlAttributes: new { @class = "control-label" })
            @Html.EditorFor(model => model.Place_Of_Birth, new { htmlAttributes = new { @class = "form-control", @maxlength = "60" } })
            @Html.ValidationMessageFor(model => model.Place_Of_Birth, "")
        </div>
        <div class="form-group clearfix">
            @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label" })<span class="text-danger">*</span>
            <div class="icheck-primary d--inline">
                @Html.RadioButtonFor(m => m.IsActive, true, new { id = "IsActive_T" })
                <label for="IsActive_T">Yes</label>
            </div>
            <div class="icheck-primary d--inline">
                @Html.RadioButtonFor(m => m.IsActive, false, new { id = "IsActive_F" })
                <label for="IsActive_F">No</label>
            </div>
            @Html.ValidationMessageFor(model => model.IsActive, "")
        </div>
        <script>
            $('.select2-edit').select2();
            $('#DateOfBirth_Edit').datetimepicker({ format: 'DD-MMM-YYYY', ignoreReadonly: true, useCurrent: true });
        </script>
    }
}