@{
    var _classAcronym = nameof(M_UserLicense).Replace("M_", "").GetUppercaseLettersAsString();
    var _controllerName = M_UserLicense._controllerName;
    ViewData["Title"] = "User Licenses";
    ViewData["Page_Header"] = "View All";
    Html.SetActiveMenuItemSystemName(nameof(SystemOperationsProvider.BMFMS.BmfMS_UserLicense), pageHeadBuilder);
}
@{ await Html.RenderPartialAsync(FixedTerms.System_PartialViewPath_AdminFeedback); }

@section Page_ImportedStyles{
    @{await Html.RenderPartialAsync("_DatatableStylesPartial");}
    <link href="~/lib/adminlte/plugins/icheck-bootstrap/icheck-bootstrap.css" rel="stylesheet" />
    <link href="~/lib/adminlte/plugins/select2/css/select2.css" rel="stylesheet" />
    <link href="~/lib/adminlte/plugins/select2-bootstrap4-theme/select2-bootstrap4.css" rel="stylesheet" />
    <link href="~/lib/adminlte/plugins/tempusdominus-bootstrap-4/css/tempusdominus-bootstrap-4.css" rel="stylesheet" />
    <link href="~/lib/adminlte/dist/css/alt/adminlte.plugins.css" rel="stylesheet" />
}
@if (ViewData["ErrorDie"] == null || (ViewData["ErrorDie"] != null && !(bool)ViewData["ErrorDie"]))
{
    <div class="card">
        @*<div class="card-header bg-primary">
                <h3 class="card-title"><i class="mr-1 icon fas fa-bars"></i> View All</h3>
            </div>*@
        <div class="card-body partial index-partial" data-u="@Url.Action("_IndexDT")">
            <div class="progress mb-3">
                <div class="progress-bar bg-primary progress-bar-striped progress-bar-animated w-100" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">
                    <span class="sr-only">Loading, please wait ....</span>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="pull-left">
                <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#M_Add@_classAcronym"><i class="mr-1 fas fa-plus"></i>Add New</button>
            </div>
        </div>
    </div>
    <div class="partial" data-u="@Url.Action("_Add", _controllerName)"></div>
    <div class="partial" data-u="@Url.Action("_Edit", _controllerName)"></div>
    <div class="partial" data-u="@Url.Action("_Delete", _controllerName)"></div>
}
@section Page_ImportedScripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    @{await Html.RenderPartialAsync("_DatatableScriptsPartial");}
    <script src="~/lib/adminlte/plugins/moment/moment.min.js"></script>
    <script src="~/lib/adminlte/plugins/tempusdominus-bootstrap-4/js/tempusdominus-bootstrap-4.js"></script>
    <script src="~/lib/adminlte/plugins/select2/js/select2.js"></script>
    <script>
        $(document).on('init.dt', '#@BMF.WebCore.Admin.Areas.BMFMS.Controllers.UserLicensesController.JQDT_Index', function () {
            var table = $(this).DataTable();
            var tableId = this.id;
            table.columns().every(function () {
                if (this.dataSrc() === 'CreatedOnUtc' || this.dataSrc() === 'UpdatedOnUtc') {
                    $('#dtfilter_' + tableId + 'filter_' + this.index()).find('input')
                        .attr('type', 'date').attr('aria-label', this.dataSrc() === 'CreatedOnUtc' ? 'Created Date' : 'Last Updated');
                }
            });
        });
    </script>
}
