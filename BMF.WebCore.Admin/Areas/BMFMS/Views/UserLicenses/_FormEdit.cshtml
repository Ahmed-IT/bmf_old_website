@model M_UserLicense
@{
    Layout = null;
}
@{ await Html.RenderPartialAsync(FixedTerms.System_PartialViewPath_AdminFeedbackPV); }
@if (ViewData["PVErrorDie"] == null || (ViewData["PVErrorDie"] != null && !(bool)ViewData["PVErrorDie"]))
{
    if (Model != null)
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ID)
        @Html.HiddenFor(model => model.RowVersion)
        <div class="form-group">
            @Html.LabelFor(model => model.ID_LicenseType, htmlAttributes: new { @class = "control-label" })
            @Html.DropDownListFor(model => model.ID_LicenseType, null, new { @class = "form-control select2-edit", @style = "width:100%;", @data_placeholder = "Select license type ...", @data_allow_clear = "true" })
            @Html.ValidationMessageFor(model => model.ID_LicenseType, "")
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.ID_MarshalRole, htmlAttributes: new { @class = "control-label" })
            @Html.DropDownListFor(model => model.ID_MarshalRole, null, new { @class = "form-control select2-edit", @style = "width:100%;", @data_placeholder = "Select marshal role ...", @data_allow_clear = "true" })
            @Html.ValidationMessageFor(model => model.ID_MarshalRole, "")
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.ID_UserProfile, htmlAttributes: new { @class = "control-label" })
            @Html.DropDownListFor(model => model.ID_UserProfile, null, new { @class = "form-control select2-edit", @style = "width:100%;", @data_placeholder = "Select user profile ...", @data_allow_clear = "true" })
            @Html.ValidationMessageFor(model => model.ID_UserProfile, "")
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.License_Number, htmlAttributes: new { @class = "control-label" })<span class="text-danger">*</span>
            @Html.EditorFor(model => model.License_Number, new { htmlAttributes = new { @class = "form-control", @required = "required", @maxlength = "50" } })
            @Html.ValidationMessageFor(model => model.License_Number, "")
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.Expire_Date, htmlAttributes: new { @class = "control-label" })<span class="text-danger">*</span>
            <div class="input-group date" id="Expire_Date_Edit" data-target-input="nearest">
                @Html.TextBox($"{nameof(Model.Expire_Date)}", Model.Display_Expire_Date, new { @class = "form-control datetimepicker-input datetimepicker-edit", @maxlength = "25", @autocomplete = "off", @data_toggle = "datetimepicker", @data_target = "#Expire_Date_Edit" })
                <div class="input-group-append" data-target="#Expire_Date_Edit" data-toggle="datetimepicker">
                    <div class="input-group-text"><i class="far fa-calendar-alt"></i></div>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.Expire_Date, "")
        </div>
        <div class="form-group clearfix">
            @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label" })<span class="text-danger">*</span>
            <div class="icheck-primary d--inline">
                @Html.RadioButtonFor(m => m.IsActive, true, new { id = "IsActive_T" })
                <label for="IsActive_T">Yes</label>
            </div>
            <div class="icheck-primary d--inline">
                @Html.RadioButtonFor(m => m.IsActive, false, new { id = "IsActive_F" })
                <label for="IsActive_F">No</label>
            </div>
            @Html.ValidationMessageFor(model => model.IsActive, "")
        </div>
        <script>
            $('.select2-edit').select2();
            $('#Expire_Date_Edit').datetimepicker({ format: 'DD-MMM-YYYY', ignoreReadonly: true, useCurrent: true });
        </script>
    }
}