@model M_UserLicenseRenewal
@{
    Layout = null;
}
@{ await Html.RenderPartialAsync(FixedTerms.System_PartialViewPath_AdminFeedbackPV); }
@if (ViewData["PVErrorDie"] == null || (ViewData["PVErrorDie"] != null && !(bool)ViewData["PVErrorDie"]))
{
    if (Model != null)
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ID)
        @Html.HiddenFor(model => model.RowVersion)
        <div class="form-group">
            @Html.LabelFor(model => model.ID_UserLicense, htmlAttributes: new { @class = "control-label" })
            @Html.DropDownListFor(model => model.ID_UserLicense, null, new { @class = "form-control select2-edit", @style = "width:100%;", @data_placeholder = "Select user license ...", @data_allow_clear = "true" })
            @Html.ValidationMessageFor(model => model.ID_UserLicense, "")
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.ApprovalStatus, htmlAttributes: new { @class = "control-label" })
            @Html.DropDownListFor(model => model.ApprovalStatus, null, new { @class = "form-control select2-edit", @style = "width:100%;", @data_placeholder = "Select status ...", @data_allow_clear = "true" })
            @Html.ValidationMessageFor(model => model.ApprovalStatus, "")
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.DateIssued, htmlAttributes: new { @class = "control-label" })<span class="text-danger">*</span>
            <div class="input-group date" id="DateIssued_Edit" data-target-input="nearest">
                @Html.TextBox($"{nameof(Model.DateIssued)}", Model.Display_DateIssued, new { @class = "form-control datetimepicker-input datetimepicker-edit", @maxlength = "25", @autocomplete = "off", @data_toggle = "datetimepicker", @data_target = "#DateIssued_Edit" })
                <div class="input-group-append" data-target="#DateIssued_Edit" data-toggle="datetimepicker">
                    <div class="input-group-text"><i class="far fa-calendar-alt"></i></div>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.DateIssued, "")
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.DateOfExpiry, htmlAttributes: new { @class = "control-label" })<span class="text-danger">*</span>
            <div class="input-group date" id="DateOfExpiry_Edit" data-target-input="nearest">
                @Html.TextBox($"{nameof(Model.DateOfExpiry)}", Model.Display_DateOfExpiry, new { @class = "form-control datetimepicker-input datetimepicker-edit", @maxlength = "25", @autocomplete = "off", @data_toggle = "datetimepicker", @data_target = "#DateOfExpiry_Edit" })
                <div class="input-group-append" data-target="#DateOfExpiry_Edit" data-toggle="datetimepicker">
                    <div class="input-group-text"><i class="far fa-calendar-alt"></i></div>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.DateOfExpiry, "")
        </div>
        <div class="form-group clearfix">
            @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label" })<span class="text-danger">*</span>
            <div class="icheck-primary d--inline">
                @Html.RadioButtonFor(m => m.IsActive, true, new { id = "IsActive_T" })
                <label for="IsActive_T">Yes</label>
            </div>
            <div class="icheck-primary d--inline">
                @Html.RadioButtonFor(m => m.IsActive, false, new { id = "IsActive_F" })
                <label for="IsActive_F">No</label>
            </div>
            @Html.ValidationMessageFor(model => model.IsActive, "")
        </div>
        <script>
            $('.select2-edit').select2();
            $('#DateIssued_Edit').datetimepicker({ format: 'DD-MMM-YYYY', ignoreReadonly: true, useCurrent: true });
            $('#DateOfExpiry_Edit').datetimepicker({ format: 'DD-MMM-YYYY', ignoreReadonly: true, useCurrent: true });
        </script>
    }
}