@model M_EventRoundSessionUserResults
@{
    Layout = null;
}
@{ await Html.RenderPartialAsync(FixedTerms.System_PartialViewPath_AdminFeedbackPV); }
@if (ViewData["PVErrorDie"] == null || (ViewData["PVErrorDie"] != null && !(bool)ViewData["PVErrorDie"]))
{
    if (Model != null)
    {
        @Html.AntiForgeryToken()
        <div class="form-group">
            @Html.LabelFor(model => model.ID_EventRoundSession, htmlAttributes: new { @class = "control-label" })<span class="text-danger">*</span>
            @Html.DropDownListFor(model => model.ID_EventRoundSession, null, new { @class = "form-control select2-add", @required = "required", @style = "width:100%;", @data_placeholder = "Select ...", @data_allow_clear = "true" })
            @Html.ValidationMessageFor(model => model.ID_EventRoundSession, "")
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.ID_UserProfile, htmlAttributes: new { @class = "control-label" })<span class="text-danger">*</span>
            @Html.DropDownListFor(model => model.ID_UserProfile, null, new { @class = "form-control select2-add", @required = "required", @style = "width:100%;", @data_placeholder = "Select ...", @data_allow_clear = "true" })
            @Html.ValidationMessageFor(model => model.ID_UserProfile, "")
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.Points, htmlAttributes: new { @class = "control-label" })<span class="text-danger">*</span>
            @Html.EditorFor(model => model.Points, new { htmlAttributes = new { @class = "form-control", @required = "required" } })
            @Html.ValidationMessageFor(model => model.Points, "")
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.BestTime, htmlAttributes: new { @class = "control-label" })
            @Html.EditorFor(model => model.BestTime, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.BestTime, "")
        </div>
        <div class="form-group clearfix">
            @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label" })<span class="text-danger">*</span>
            <div class="icheck-primary d--inline">
                @Html.RadioButtonFor(m => m.IsActive, true, new { id = "IsActive_T" })
                <label for="IsActive_T">Yes</label>
            </div>
            <div class="icheck-primary d--inline">
                @Html.RadioButtonFor(m => m.IsActive, false, new { id = "IsActive_F" })
                <label for="IsActive_F">No</label>
            </div>
            @Html.ValidationMessageFor(model => model.IsActive, "")
        </div>
        <script>
            $('.select2-add').select2();
        </script>
    }
}