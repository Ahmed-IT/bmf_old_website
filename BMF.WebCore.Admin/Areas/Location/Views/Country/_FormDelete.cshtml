@model Country
@{
    Layout = null;
}
@{ await Html.RenderPartialAsync(FixedTerms.System_PartialViewPath_AdminFeedbackPV); }
@if (ViewData["PVErrorDie"] == null || (ViewData["PVErrorDie"] != null && !(bool)ViewData["PVErrorDie"]))
{
    if (Model != null)
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ID)
        @Html.HiddenFor(model => model.RowVersion)
        <h4>Are you sure you want to delete this Country?</h4>
        <table class="table table-striped table-hover table-bordered table-sm">
            <tr>
                <th>@Html.LabelFor(model => model.Name)</th>
                <td>@Model.Name</td>
            </tr>
            <tr>
                <th>@Html.LabelFor(model => model.Demonym)</th>
                <td>@Model.Demonym</td>
            </tr>
            <tr>
                <th>@Html.LabelFor(model => model.AlphaCode_2)</th>
                <td>@Model.AlphaCode_2</td>
            </tr>
            <tr>
                <th>@Html.LabelFor(model => model.AlphaCode_3)</th>
                <td>@Model.AlphaCode_3</td>
            </tr>
            <tr>
                <th>@Html.LabelFor(model => model.NumericCode)</th>
                <td>@Model.NumericCode</td>
            </tr>
            <tr>
                <th>@Html.LabelFor(model => model.Region)</th>
                <td>@Model.Region</td>
            </tr>
            <tr>
                <th>@Html.LabelFor(model => model.SubRegion)</th>
                <td>@Model.SubRegion</td>
            </tr>
            <tr>
                <th>@Html.LabelFor(model => model.CallingCode)</th>
                <td>@Model.CallingCode</td>
            </tr>
            <tr>
                <th>@Html.LabelFor(model => model.Display_IsActive)</th>
                <td>@Model.Display_IsActive</td>
            </tr>
        </table>
    }
}