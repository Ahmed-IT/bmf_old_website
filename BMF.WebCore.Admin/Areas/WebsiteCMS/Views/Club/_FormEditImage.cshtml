@model M_Club
@{
    Layout = null;
}
@{ await Html.RenderPartialAsync(FixedTerms.System_PartialViewPath_AdminFeedbackPV); }
@if (ViewData["PVErrorDie"] == null || (ViewData["PVErrorDie"] != null && !(bool)ViewData["PVErrorDie"]))
{
    if (Model != null)
    {
        <div class="modal-body">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ID)
            @Html.HiddenFor(model => model.RowVersion)
            <table class="table table-striped table-hover table-bordered table-sm">
                <tr>
                    <th>@Html.LabelFor(model => model.Title)</th>
                    <td>@Model.Title</td>
                </tr>
                <tr>
                    <th>@Html.LabelFor(model => model.Website_Link)</th>
                    <td>@Model.Website_Link</td>
                </tr>
                <tr>
                    <th>@Html.LabelFor(model => model.Description)</th>
                    <td>@Model.Description</td>
                </tr>
            </table>
            <hr />
            <div class="container">
                <div class="row">
                    <div class="col">
                        <h3>Logo</h3>
                        <input id="ImageUploadLogo" name="ImageUpload" type="file">

                    </div>
                    <div class="col">
                        <h3>Banner</h3>
                        <input id="ImageUploadBanner" name="ImageUpload" type="file">
                    </div>
                </div>
            </div>

        </div>
        <div class="modal-footer justify-content-between">
            <button type="button" class="btn btn-default" data-dismiss="modal"><i class="mr-1 fas fa-times"></i>Close</button>
        </div>
        <script id="image-upload">
            var URL_ImageLogo_Overview = ["@Model.Image_URL_Logo"],
                Data_ImageLogo_Overview = [{ downloadUrl: "@Model.Image_URL_Logo", key: @Model.ID, caption: "@Model.Title" }];
            var URL_ImageBanner_Overview = ["@Model.Image_URL_Banner"],
                Data_ImageBanner_Overview = [{ downloadUrl: "@Model.Image_URL_Banner", key: @Model.ID, caption: "@Model.Title" }];
            $("#ImageUploadLogo").fileinput({
                theme: 'fas',
                required: true,
                showDrag: false,
                showRemove: false,
                overwriteInitial: true,
                initialPreview: URL_ImageLogo_Overview,
                initialPreviewAsData: true,
                minFileCount: 1,
                maxFileCount: 1,
                validateInitialCount: true,
                maxFileSize: 5000,
                allowedFileExtensions: ["jpeg", "jpg", "png"],
                initialPreviewConfig: Data_ImageLogo_Overview,
                uploadUrl: '@Url.Action("UploadImageLogo", new { Model.ID })',
                //deleteUrl: '@Url.Action("DeleteImageLogo", new { Model.ID })',
            });
            $("#ImageUploadBanner").fileinput({
                theme: 'fas',
                required: true,
                showDrag: false,
                showRemove: false,
                overwriteInitial: true,
                initialPreview: URL_ImageBanner_Overview,
                initialPreviewAsData: true,
                minFileCount: 1,
                maxFileCount: 1,
                validateInitialCount: true,
                maxFileSize: 5000,
                allowedFileExtensions: ["jpeg", "jpg", "png"],
                initialPreviewConfig: Data_ImageBanner_Overview,
                uploadUrl: '@Url.Action("UploadImageBanner", new { Model.ID })',
                //deleteUrl: '@Url.Action("DeleteImageBanner", new { Model.ID })',
            });

            var getFileSize = function (url) {
                var req = $.ajax({
                    type: "HEAD",
                    url: url,
                    success: function () {
                        return (req.getResponseHeader("Content-Length") * 1048576);
                    }
                });
            }
        </script>
    }
}