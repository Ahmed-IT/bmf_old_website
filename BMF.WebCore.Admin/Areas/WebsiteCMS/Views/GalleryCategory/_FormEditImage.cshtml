@model M_GalleryCategory
@{
    Layout = null;
}
@{ await Html.RenderPartialAsync(FixedTerms.System_PartialViewPath_AdminFeedbackPV); }
@if (ViewData["PVErrorDie"] == null || (ViewData["PVErrorDie"] != null && !(bool)ViewData["PVErrorDie"]))
{
    if (Model != null)
    {
        <div class="modal-body">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ID)
            @Html.HiddenFor(model => model.RowVersion)
            <table class="table table-striped table-hover table-bordered table-sm">
                <tr>
                    <th>@Html.LabelFor(model => model.Title)</th>
                    <td>@Model.Title</td>
                </tr>
            </table>
            <hr />
            <h5>Cover Image</h5>
            <input id="ImageUpload" name="ImageUpload" type="file">

            <hr />
            <h5>Images</h5>
            <input id="ImagesUpload" name="ImagesUpload" type="file" multiple>
        </div>
        <div class="modal-footer justify-content-between">
            <button type="button" class="btn btn-default" data-dismiss="modal"><i class="mr-1 fas fa-times"></i>Close</button>
        </div>
        <script id="coverimage-upload">
            var URL_CoverImage_Overview = ["@Model.Image_URL"],
                Data_CoverImage_Overview = [{ downloadUrl: "@Model.Image_URL", key: @Model.ID, caption: "@Model.Title" }];
            $("#ImageUpload").fileinput({
                theme: 'fas',
                required: true,
                showDrag: false,
                showRemove: false,
                overwriteInitial: true,
                initialPreview: URL_CoverImage_Overview,
                initialPreviewAsData: true,
                minFileCount: 1,
                maxFileCount: 1,
                validateInitialCount: true,
                maxFileSize: 5000,
                allowedFileExtensions: ["jpeg", "jpg", "png"],
                initialPreviewConfig: Data_CoverImage_Overview,
                uploadUrl: '@Url.Action("UploadImage", new { Model.ID })',
                //deleteUrl: '@Url.Action("DeleteImage", new { Model.ID })',
            });

            var URL_Image_Overview = @Html.Raw(JsonConvert.SerializeObject(Model.GalleryImages.Select(s => s.Image_URL).ToArray(), FixedTerms.JsonSettings_IgnoreNull)),
                Data_Image_Overview = @Html.Raw(JsonConvert.SerializeObject(Model.GalleryImages.Select(s => new KatrikFilePreviewConfig() { downloadUrl = s.Image_URL, key = s.ID, caption = s.ID.ToString() }).ToArray(), FixedTerms.JsonSettings_IgnoreNull));
            $("#ImagesUpload").fileinput({
                theme: 'fas',
                initialPreview: URL_Image_Overview,
                initialPreviewAsData: true,
                showDrag: false,
                initialPreviewConfig: Data_Image_Overview,
                uploadUrl: "@Url.Action("UploadImages", new { Model.ID })",
                deleteUrl: "@Url.Action("DeleteImages", new { Model.ID })",
                overwriteInitial: false,
                maxFileSize: 5000,
                allowedFileExtensions: ["jpeg", "jpg", "png"],
            });

            var getFileSize = function (url) {
                var req = $.ajax({
                    type: "HEAD",
                    url: url,
                    success: function () {
                        return (req.getResponseHeader("Content-Length") * 1048576);
                    }
                });
            }
        </script>
    }
}