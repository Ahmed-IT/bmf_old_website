@model BMF_WebSite.Models.ViewModels.EventCalendarVM.Calendar
@{
    ViewBag.Title = "EventCalendar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<section id="banner-2">
    <div class="container">
        <div class="row">
            <div class="col-lg-7 col-md-7 col-sm-12 col-10 mobile-auto">
                <div class="luanch">
                    <div class="coundown_res">
                        <div class="row">
                            <br />
                            <br />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-md-1"></div>
            <div class="col-lg-3 col-md-4">

            </div>
        </div>
    </div>
</section>

<section id="event">
    <div class="container zindex">
        <div class="row">
            <div class="col-lg-12 speaker-heading">
                <h3 style=" font-family: DinoB;">Calendar</h3>
                <div class="header-style"></div>
            </div>
        </div>

        <br /><br />
              
        <div style="color: red; font-family: DinoR; font-size: 16px;"><a class="link-danger" href="@Url.Action("Calendar","EventCalendar",null)"><i class="fa fa-calendar"></i> View Full Calendar</a></div>
        <br />
        <div class="row">
            @foreach (var item in Model.EventsCategory)
            {
            

                <div class="col-lg-4 blog-item" style="margin:10px;">
                    <div class="blog-shadow">
                        <a href="@Url.Action("EventFullCalendar","EventCalendar",new { Id = item.ID})">
                            <div class="card border-0 rounded-0 bg-dark text-white">
                                <img src="@item.Image_URL" class="card-img">
                                <div class="card-img-overlay h-100 d-flex flex-column justify-content-start">
                                    <div style="margin:10px; float:left; margin-right:auto; color:white;">
                                        <br />
                                        <h3 style="font-family: DinoB;">@item.Title</h3>
                                        <br />
                                        <p style="font-size: 14px; font-family: DinoR;">NEXT ROUND</p>

                                        @if (item.NextRound != null)
                                        {
                                            if (item.NextRound.Round_Number != "NA")
                                            {
                                                if (item.NextRound.DateTime_Start.Day != item.NextRound.DateTime_End.Day)
                                                {
                                                    <h4 style="text-transform: uppercase; font-family: DinoB;">@item.NextRound.Round_Number</h4>
                                                    <p style="font-size: 14px; text-transform: uppercase; font-family: DinoR;">@item.NextRound.DateTime_Start.ToString("dd") to @item.NextRound.DateTime_End.ToString("dd MMM yyyy")</p>

                                                }
                                                else
                                                {
                                                    <h4 style="text-transform: uppercase; font-family: DinoB;">@item.NextRound.Round_Number</h4>
                                                    <p style="font-size: 14px; text-transform: uppercase; font-family: DinoR;">@item.NextRound.DateTime_Start.ToString("dd MMM yyyy")</p>
                                                }

                                            }
                                            else
                                            {
                                                if (item.NextRound.DateTime_Start.Day != item.NextRound.DateTime_End.Day)
                                                {
                                                    <h4 style="text-transform: uppercase; font-family: DinoB;">@item.NextRound.Round_Number</h4>
                                                    <p style="font-size: 14px; text-transform: uppercase; font-family: DinoR;">@item.NextRound.DateTime_Start.ToString("dd") to @item.NextRound.DateTime_End.ToString("dd MMM yyyy")</p>
                                                }
                                                else
                                                {
                                                    <h4 style="text-transform: uppercase; font-family: DinoB;">@item.NextRound.Round_Number</h4>
                                                    <p style="font-size: 14px; text-transform: uppercase; font-family: DinoR;">@item.NextRound.DateTime_Start.ToString("dd MMM yyyy")</p>
                                                }

                                            }
                                        }
                                        else
                                        {
                                            <h5 style="text-transform: uppercase; font-family: DinoB;">No Coming Race</h5>
                                        }

                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>                
            }


        </div>




    </div>
</section>