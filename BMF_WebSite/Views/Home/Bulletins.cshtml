@model List<BMF_WebSite.Models.ClsBRCategory>
@{
    ViewBag.Title = "Bulletins";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section id="banner-2">
    <div class="container">
        <div class="row">
            <div class="col-lg-7 col-md-7 col-sm-12 col-10 mobile-auto">
                <div class="luanch">
                    <div class="coundown_res">
                        <div class="row">
                            <br />
                            <br />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-md-1"></div>
            <div class="col-lg-3 col-md-4">

            </div>
        </div>
    </div>
</section>

<section id="event">
    <div class="container zindex">
        <div class="row">
            <div class="col-lg-12 speaker-heading">
                <h3>BULLETINS</h3>
                <div class="header-style"></div>
            </div>
        </div>

        <br /><br />

        <div class="row">
            @*<div class="col-lg-5">
                <img class="rounded float-start" src="~/Content/images/Rotax.png" style="width:95%;" />
            </div>*@
            <div class="col-lg-12 about-txt">

                <p>
                    The Bahrain Motor Federation (BMF) is recognized as the sole motor sport governing body for the Kingdom of Bahrain by the world governing body, the Federation International de L' Automobile (FIA).
                    <br /><br />
                    As the governing body, the BMF is responsible for the governance and administration of all major forms of motor sports in Bahrain, controlling the technical and sporting rules across the various disciplines.
                    <br /><br />
                    The BMF implements these rules to govern the conduct of motor sports.
                </p>

            </div>
        </div>

        <div class="accordion" id="accordionExample">
            @if (Model != null)
            {
                int i = 1;

                foreach (var category in Model)
                {

            <div class="accordion-item">
                <h2 class="accordion-header" id="@("heading"+i)">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="@("#collapse"+i)" aria-expanded="false" aria-controls="@("#collapse"+i)">
                        @category.Title
                    </button>
                </h2>

                <div id="@("collapse"+i)" class="accordion-collapse collapse" aria-labelledby="@("heading"+i)" data-bs-parent="#accordionExample">
                    <div class="accordion-body">

                        @foreach (var item in category.SubCategory.Where(a => a.Bulletins.Count != 0))
                        {
                            <figure>
                                <blockquote class="blockquote">
                                    <p>@item.Title</p>
                                </blockquote>

                                @foreach (var item2 in item.Bulletins)
                                {
                                    <figcaption class="blockquote-footer">
                                        <a href="@item2.PDF_Url">@item2.Title</a>
                                    </figcaption>
                                }


                            </figure>

                        }

                    </div>
                </div>

            </div>


                    i++;
                }
            }


        </div>
    </div>
</section>


