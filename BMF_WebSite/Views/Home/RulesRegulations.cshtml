@model List<BMF_WebSite.Models.ClsEventCategory>
@{
    ViewBag.Title = "RulesRegulations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<section id="banner-2">
    <div class="container">
        <div class="row">
            <div class="col-lg-7 col-md-7 col-sm-12 col-10 mobile-auto">
                <div class="luanch">
                    <div class="coundown_res">
                        <div class="row">
                            <br />
                            <br />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-md-1"></div>
            <div class="col-lg-3 col-md-4">

            </div>
        </div>
    </div>
</section>


<section id="event">
    <div class="container zindex">
        <div class="row">
            <div class="col-lg-12 speaker-heading">
                <h3>RULES AND REGULATIONS</h3>
            </div>
        </div>

        <br />

        <div class="row">
            <div class="col-lg-12 about-txt">

                <p style="font-size:14px; text-align:justify;">
                    The Bahrain Motor Federation (BMF) is recognized as the sole motor sport governing body for the Kingdom of Bahrain by the world governing body, the Federation International de L' Automobile (FIA).
                    <br />
                    As the governing body, the BMF is responsible for the governance and administration of all major forms of motor sports in Bahrain, controlling the technical and sporting rules across the various disciplines.
                    <br />
                    The BMF implements these rules to govern the conduct of motor sports.
                </p>

            </div>
        </div>

        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-lg-3 blog-item" style="margin:10px;">
                    <div class="blog-shadow">
                        <div class="card border-0 rounded-0 bg-dark text-white">
                            <a style="z-index: 999;" href="@Url.Action("EventRulesRegs","Home",new { ID = item.ID})"><img src="@item.Image_URL" class="card-img"></a>
                            <div class="card-img-overlay h-100 d-flex flex-column justify-content-end">
                                <div style="z-index: 9999; background-color: rgba(0, 0, 0, 0.7); height: 70px;">
                                    <div style="margin:10px;">
                                        <h5 class="card-title" style="font-family:FjallaOneR; font-size:16px;">@item.Title</h5>
                                        <h5 class="card-subtitle" style="font-family:LatoR; font-size:14px; margin-top:5px;">Rules and Regulations</h5>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <br /><br />
        </div>
    </div>
</section>
