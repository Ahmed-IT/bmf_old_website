<!-- BANNER AREA START -->
<section id="banner">
    <div class="backtotop">
        <a href="#banner"><i class="fa fa-rocket" aria-hidden="true"></i></a>
    </div>
    <div class="container zindex">
        <div class="row">
            <div class="col-lg-7 banner-txt">
                <h1>Bahrain Motor Federation</h1>
                <p style="text-align:justify; color:white; font-size:16px;">Founded on 23rd November, 1952, the Bahrain Motor Federation is proud of its long heritage and the close relationship. It has enjoyed with the government and leading families in the Kingdom of Bahrain. The Clubs first chairman was Mr. Ahmed Kanoo, Its Honorary Secretary, Mr. R A Allen, its Honorary Treasurer, Mr. G Thompson and Committee Members, Mr. M Rule, Mr. R Smyth, Mr. Khalil Kanoo and Mr. Al-Zayani</p>
            </div>
        </div>

    </div>
</section>
