<section class="bg-dark mobile-auto ComingEventsBackground" id="blog">
    <div class="container" style="height:100%;">
        <div class="bg-transparent mobile-auto" style="height:100%;">
            <div class="CountdownBox">
                <div style="display:none;" id="countdown"></div>
                <div class="row">
                    <div class="col-lg-4 CountdownEventTitle">
                        @Html.HiddenFor(u => u.Countdown.DateTime_Start, new { @id = "DateTime_Start" })
                        <div style="margin:20px;">
                            <h4 style="font-family: DinoB;">
                                @Model.Countdown.M_EventCategory.Title @Model.Countdown.Round_Number
                            </h4>
                            <h5 style="font-family: DinoR;">
                                @Model.Countdown.DateTime_Start.ToString("dd MMM yyyy")
                            </h5>
                        </div>
                    </div>
                    <div class="col-lg-8 CountdownEventTitle">
                        <div class="row" style="margin-top:20px; margin-left:20px;">
                            <div class="col-lg-3 col-sm-3 col-3 m-responsive count-item">
                                <div class="coun">
                                    <div class="coun_time">
                                        <h3 style="font-family: DinoB;" id="day" class="coming-data">0</h3>
                                        <p style="font-family: DinoR; font-size: 14px; " class="coming-data2 special-pos">Days</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-sm-3 col-3 m-responsive count-item">
                                <div class="coun">
                                    <div class="coun_time">
                                        <h3 style="font-family: DinoB;" id="hour" class="coming-data">0</h3>
                                        <p style="font-family: DinoR; font-size: 14px; " class="coming-data2">Hrs</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-sm-3 col-3 m-responsive count-item">
                                <div class="coun">
                                    <div class="coun_time">
                                        <h3 style="font-family: DinoB;" id="minute" class="coming-data">0</h3>
                                        <p style="font-family: DinoR; font-size: 14px; " class="coming-data2">Min</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-sm-3 col-3 m-responsive count-item">
                                <div class="coun">
                                    <div class="coun_time">
                                        <h3 style="font-family: DinoB;" id="second" class="coming-data">0</h3>
                                        <p style="font-family: DinoR; font-size:14px;" class="coming-data2">Sec</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <br />
        </div>

        <div class="row blog-pa">
            <div class="col-lg-12">
                <div class="blog-main">
                    @if (Model.ComingEvents != null)
                    {
                        foreach (var item in Model.ComingEvents)
                        {
                            <div class="col-lg-4 blog-item" style="margin:10px;">
                                <div class="blog-shadow">
                                    <div class="card border-0 rounded-0 bg-dark text-white">
                                        <img src="@item.M_EventCategory.Image_URL" class="card-img">
                                        <div class="card-img-overlay h-100 d-flex flex-column justify-content-start">
                                            <div style="margin:10px; float:left; margin-right:auto; color:white;">
                                                <h2 style="font-family: DinoB;">@item.M_EventCategory.Title</h2>
                                                <br />
                                                <p style="font-size: 14px; font-family: DinoR;">NEXT ROUND</p>
                                                <h4 style="text-transform: uppercase; font-family: DinoB;">@item.Round_Number</h4>
                                                <p style="font-size: 14px; text-transform: uppercase; font-family: DinoR;">@item.DateTime_Start.ToString("dd MMM yyyy")</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</section>

