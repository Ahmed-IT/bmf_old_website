                        if (i == 1)
                        {
                            <div class="carousel-item active">
                                <div class="row">                                        
                                    <div class="col-md-4" style="background-color:white;">
                                        <br />
                                        <div style="text-align:center;">
                                            <a href="@item.Website_Link">
                                                <img src="@item.Image_URL_Logo" style="width:40%;">
                                            </a>
                                        </div>
                                        <div style="margin: 10px; font-family: DinoR; font-size:14px;">
                                            <h5 style="font-family: DinoB;">@item.Title</h5>
                                            <br />
                                            @item.Description
                                           <br />
                                            <a style="font-family: DinoR; color:red;" href="@item.Website_Link" class="link-dark">Visit Website</a>
                                        </div>
                                        <br />
                                    </div>
                                    <div class="col-md-8" style="background-color:lightgray; padding:0;">
                                        <a href="@item.Website_Link">
                                            <img class="img-fluid" src="@item.Image_URL_Banner" style="background-color:lightgray; width:100%;" />
                                        </a>
                                        
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
            <div class="carousel-item">
                <div class="row">
                    <div class="col-md-4" style="background-color:white;">
                        <br />
                        <div style="text-align:center;">
                            <a href="@item.Website_Link">
                                <img src="@item.Image_URL_Logo" style="width:40%;">
                            </a>
                        </div>
                        <div style="margin: 10px; font-size: 14px; font-family: DinoR;">
                            <h5 style="font-family: DinoB;">@item.Title</h5>
                            <br />
                            @item.Description
                            <br />
                            <a style="font-family: DinoR; color:red;" href="@item.Website_Link" class="link-dark">Visit Website</a>
                        </div>
                        <br />
                    </div>
                    <div class="col-md-8" style="background-color:lightgray; padding:0;">
                        <a href="@item.Website_Link">
                            <img class="img-fluid" src="@item.Image_URL_Banner" style="background-color:lightgray; width:100%;" />
                        </a>
                    </div>
                </div>
            </div>
                        }

                        i++;
                    }
                }

            </div>
            <div class="carousel-indicators">
                @if (Model.Clubs != null)
                {
                    int i = 0;

                    if (Request.Browser.IsMobileDevice)
                    {
                        foreach (var item in Model.Clubs)
                        {
                            if (i == 0)
                            {
                                <input type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="@i.ToString()" class="active" aria-current="true" />
                            }
                            else
                            {
                                <input type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="@i.ToString()" aria-current="true" />
                            }

                            i++;
                        }
                    }
                    else
                    {
                        foreach (var item in Model.Clubs)
                        {
                            if (i == 0)
                            {
                                <input type="button" style="width:70px; height:70px; background-image:url('@item.Image_URL_Logo'); background-size:70px; background-position:center; background-repeat:no-repeat; background-color:white;" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="@i.ToString()" class="active" aria-current="true" aria-label="Slide 1" />
                            }
                            else
                            {
                                <input type="button" style="width:70px; height:70px; background-image:url('@item.Image_URL_Logo'); background-size:70px; background-position:center; background-repeat:no-repeat; background-color:white;" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="@i.ToString()" aria-current="true" aria-label="Slide 1" />
                            }

                            i++;
                        }
                    }
                }
            </div>

            
        </div>


        <br />
    </div>
</section>

