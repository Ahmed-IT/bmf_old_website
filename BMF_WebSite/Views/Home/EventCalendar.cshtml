@model BMF_WebSite.Models.ViewModels.EventCalendarVM.Calendar
@{
    ViewBag.Title = "EventCalendar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<section id="banner-2">
    <div class="container">
        <div class="row">
            <div class="col-lg-7 col-md-7 col-sm-12 col-10 mobile-auto">
                <div class="luanch">
                    <div class="coundown_res">
                        <div class="row">
                            <br />
                            <br />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-md-1"></div>
            <div class="col-lg-3 col-md-4">

            </div>
        </div>
    </div>
</section>

<section id="event">
    <div class="container zindex">
        <div class="row">
            <div class="col-lg-12 speaker-heading">
                <h3>Calendar</h3>
                <div class="header-style"></div>
            </div>
        </div>

        <br /><br />

        <div style="color:red; font-family:LatoB; font-size:16px;"><a class="link-danger" href="@Url.Action("Calendar","Home",null)"><i class="fa fa-calendar"></i> View Full Calendar</a></div>
        <br />
        <div class="row">
            @foreach (var item in Model.EventsCategory)
            {
                <div class="col-md-4" style="margin-bottom:20px;">
                    <div class="card border-0 rounded-0 bg-dark text-white">
                        <a style="z-index: 999;" href="@Url.Action("EventFullCalendar","Home",new { ID = item.ID})"><img src="@item.Image_URL" class="card-img"></a>


                        <div class="card-img-overlay h-100 d-flex flex-column justify-content-end">
                            <div style="background-color: rgba(0, 0, 0, 0.7); height:70px;z-index: 9999;">
                                <div style="margin:10px;">
                                    <h5 class="card-title" style="font-family:FjallaOneR"><a style="color:white;" href="@Url.Action("EventFullCalendar","Home",new { ID = item.ID})">@item.Title</a></h5>
                                    @if (item.NextRound != null)
                                    {
                                        if (item.NextRound.Round_Number != "NA")
                                        {
                                            if (item.NextRound.DateTime_Start.Day != item.NextRound.DateTime_End.Day)
                                            {
                                                <p style="font-family:LatoR" class="card-subtitle">Next Race: Round @item.NextRound.Round_Number - @item.NextRound.DateTime_Start.ToString("dd") to @item.NextRound.DateTime_End.ToString("dd MMM yyyy")</p>
                                            }
                                            else
                                            {
                                                <p style="font-family:LatoR" class="card-subtitle">Next Race: Round @item.NextRound.Round_Number - @item.NextRound.DateTime_Start.ToString("dd MMM yyyy")</p>
                                            }

                                        }
                                        else
                                        {
                                            if (item.NextRound.DateTime_Start.Day != item.NextRound.DateTime_End.Day)
                                            {
                                                <p style="font-family:LatoR" class="card-subtitle">Next Race: @item.NextRound.DateTime_Start.ToString("dd") to @item.NextRound.DateTime_End.ToString("dd MMM yyyy")</p>
                                            }
                                            else
                                            {
                                                <p style="font-family:LatoR" class="card-subtitle">Next Race: @item.NextRound.DateTime_Start.ToString("dd MMM yyyy")</p>
                                            }

                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }


        </div>




    </div>
</section>