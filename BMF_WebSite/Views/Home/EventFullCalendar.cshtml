@model List<BMF_WebSite.Models.ClsEventRound>
@{
    ViewBag.Title = "EventFullCalendar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section id="banner-2">
    <div class="container">
        <div class="row">
            <div class="col-lg-7 col-md-7 col-sm-12 col-10 mobile-auto">
                <div class="luanch">
                    <div class="coundown_res">
                        <div class="row">
                            <br />
                            <br />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-md-1"></div>
            <div class="col-lg-3 col-md-4">

            </div>
        </div>
    </div>
</section>

<section id="event">
    <div class="container zindex">
        <div class="row">
            <div class="col-lg-12 speaker-heading">
                <h3>Calendar</h3>
                <div class="header-style"></div>
            </div>
        </div>

        <br /><br />

        <div class="row">
            <div class="col-md-6">
                <h4 style="margin-bottom:20px; font-family:FjallaOneR;">@Model.FirstOrDefault().EventCategory.Title Calendar</h4>
                <table class="table table-striped table-responsive">
                    <thead>
                        <tr>
                            <th class="text-center" style="background-color:#E52F2F; color:white; font-family:FjallaOneR;">Round</th>
                            <th class="text-center" style="background-color:#E52F2F; color:white; font-family:FjallaOneR;">Date From</th>
                            <th class="text-center" style="background-color:#E52F2F; color:white; font-family:FjallaOneR;">Date To</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderBy(a => a.DateTime_Start).ToList())
                        {
                            <tr>
                                <td style="font-family:LatoB;" class="text-center">Round @item.Round_Number</td>
                                <td style="font-family:LatoR;" class="text-center">@item.DateTime_Start.ToString("dd MMM yyyy")</td>
                                <td style="font-family:LatoR;" class="text-center">@item.DateTime_End.ToString("dd MMM yyyy")</td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
            
        </div>
    </div>
</section>



