                                @Html.TextBoxFor(u => u.BlockNumber, new { @class = "form-control", @required = "required", @placeholder = "Required Field" })
                                @Html.ValidationMessageFor(model => model.BlockNumber, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group col-md-3">
