        <section id="divRegForm">
            <div class="col-lg-12">
                <div class="purchase-box">
                    <h4>Registration Form</h4>

                    @try
                    {
                        if (TempData["Status"] != null)
                        {
                            if (TempData["Status"].ToString() == "Exist")
                            {
                                <script>
                                    $(document).ready(function () {
                                        // Handler for .ready() called.
                                        $('html, body').animate({
                                            scrollTop: $('#divRegForm').offset().top
                                        }, 'slow');
                                    });
                                </script>

                                <br /><br />
                                <div class="alert alert-danger" role="alert" style="text-align:center; color:red; font-size:18px;">
                                    Your information already exist and enrolled.
                                </div>
                            }
                            else
                            {
                                <script>
                                    $(document).ready(function () {
                                        // Handler for .ready() called.
                                        $('html, body').animate({
                                            scrollTop: $('#divRegForm').offset().top
                                        }, 'slow');
                                    });
                                </script>

                                <br /><br />
                                <div class="alert alert-danger" role="alert" style="text-align:center; color:red; font-size:18px;">
                                    Error in submitting your form, please check your information.
                                </div>
                            }
                        }
                    }
                    catch (global::System.Exception)
                    {

                    }


                    @using (Html.BeginForm("eSport", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="form-group col-md-4">
                                <label style="font-family:LatoB;">CPR Number <b style="color: red;">*</b></label>
                                @Html.TextBoxFor(u => u.CPR, new { @class = "form-control", @required = "required", @placeholder = "Required Field" })
                                @Html.ValidationMessageFor(model => model.CPR, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group col-md-4">
                                <label style="font-family:LatoB;">First Name <b style="color: red;">*</b></label>
                                @Html.TextBoxFor(u => u.FirstName, new { @class = "form-control", @required = "required", @placeholder = "Required Field" })
                                @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group col-md-4">
                                <label style="font-family:LatoB;">Middle Name <b style="color: red;">*</b></label>
                                @Html.TextBoxFor(u => u.MiddleName, new { @class = "form-control", @required = "required", @placeholder = "Required Field" })
                                @Html.ValidationMessageFor(model => model.MiddleName, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group col-md-4">
                                <label style="font-family:LatoB;">Last Name <b style="color: red;">*</b></label>
                                @Html.TextBoxFor(u => u.LastName, new { @class = "form-control", @required = "required", @placeholder = "Required Field" })
                                @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group col-md-4">
                                <label style="font-family:LatoB;">Nationality <b style="color: red;">*</b></label>
                                @Html.DropDownListFor(model => model.CountryId, new SelectList(ViewBag.Countries, "ID", "Name"), "Select Nationality", new { @class = "form-control", @required = "required" })
                                @Html.ValidationMessageFor(model => model.CountryId, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group col-md-3">
                                <label style="font-family:LatoB;">House Number <b style="color: red;">*</b></label>
                                @Html.TextBoxFor(u => u.HouseNumber, new { @class = "form-control", @required = "required", @placeholder = "Required Field" })
