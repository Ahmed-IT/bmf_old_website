@model BMF_WebSite.Models.ClsLicForm
@{
    ViewBag.Title = "CompetitionLicense";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section id="banner-2">
    <div class="container">
        <div class="row">
            <div class="col-lg-7 col-md-7 col-sm-12 col-10 mobile-auto">
                <div class="luanch">
                    <div class="coundown_res">
                        <div class="row">
                            <br />
                            <br />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-md-1"></div>
            <div class="col-lg-3 col-md-4">

            </div>
        </div>
    </div>
</section>

<section id="organize_2">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-sm-6 org-item sm-style-h">
                <h3 style="font-family:FjallaOneR;">
                    <a href='@Url.Action("CdpApplication","Home",null)'>CPD APPLICATION</a>
                </h3>
            </div>
            <div class="col-lg-3 col-sm-6 org-item">
                <h3 style="font-family:FjallaOneR;">
                    <a href='@Url.Action("CompetitionLicense","Home",null)'>COMPETITION LICENSE</a>
                </h3>

            </div>
        </div>
    </div>
</section>

<section id="event">
    <div class="container zindex">
        <div class="row">
            <div class="col-lg-12 speaker-heading">
                <h3>COMPETITION LICENSE</h3>
                <div class="header-style"></div>
            </div>
        </div>

        <br /><br />

        <div class="row">
            <div class="col-lg-5">
                <img class="rounded float-start" src="~/Content/images/2000cc.jpeg" style="width:95%;" />
            </div>
            <div class="col-lg-7 about-txt">

                <p style="font-size:16px;">
                    The Bahrain Motor Federation (BMF) has been empowered by the Federation International De L Automobile (FIA) to register and license Bahrain citizens wishing to compete nationally under the BMFs Motor Sports Regulations and/or internationally under the FlAs International Sporting Code.
                    <br /><br />
                    Under certain circumstances citizens of other countries may also apply for registration.
                    <br /><br />
                    Registration will be effected by the issue of a Competition License of a type applicable to the motor sports discipline and the status, National or International, in which the applicant wishes to compete.
                </p>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12 about-txt">
                <p style="font-size:16px;">
                    Subject to certain conditions a status of license may be upgraded at any time during the year.
                    <br />
                    Important! Registration shall expire at the end of the year shown on the Competition License.
                    <br />
                    Any person wishing to register must complete a Competition License application form. All applicants will be required to pass a medical examination.
                    <br /><br /><br />
                    <a class="link link-danger" target="_blank" href="https://bmfstorage.blob.core.windows.net/general-files/APPLICATION_FORM.pdf">Competition License application form</a>
                    <br /><br /><br />
                    <a target="_blank" href="https://bmfstorage.blob.core.windows.net/general-files/MEDICAL_FORM.pdf">Medical Test Form</a>
                </p>
            </div>
        </div>


        <div class="col-lg-12">
            <div class="purchase-box">
                <h4>Application Form for Competition Licence</h4>
                <form>
                    <div class="row">
                        <div class="form-group col-md-6">
                            <select class="form-control">
                                <option value="">Competion License Category</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            <select class="form-control">
                                <option value="">License Type</option>
                                <option value="New">New</option>
                                <option value="Renew">Renew</option>
                            </select>
                        </div>
                        <div class="form-group col-md-6">
                            <input type="text" class="form-control" placeholder="CPR Number">
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-3">
                            <input type="text" class="form-control" placeholder="First Name">
                        </div>
                        <div class="form-group col-md-3">
                            <input type="text" class="form-control" placeholder="Middle Name">
                        </div>
                        <div class="form-group col-md-3">
                            <input type="text" class="form-control" placeholder="Last Name">
                        </div>
                        <div class="form-group col-md-3">
                            <select class="form-control">
                                <option value="value">Select Nationality</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-3">
                            <input type="text" class="form-control" placeholder="House/Building">
                        </div>
                        <div class="form-group col-md-3">
                            <input type="text" class="form-control" placeholder="Road">
                        </div>
                        <div class="form-group col-md-3">
                            <input type="text" class="form-control" placeholder="Block">
                        </div>
                        <div class="form-group col-md-3">
                            <input type="text" class="form-control" placeholder="City">
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            <input type="text" class="form-control" placeholder="Place of Birth">
                        </div>
                        <div class="form-group col-md-6">
                            <input type="text" class="form-control" placeholder="Date of Birth">
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            <input type="text" class="form-control" placeholder="Mobile">
                        </div>
                        <div class="form-group col-md-6">
                            <input type="text" class="form-control" placeholder="Email">
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            <input type="text" class="form-control" placeholder="Telephone">
                        </div>
                        <div class="form-group col-md-6">
                            <input type="text" class="form-control" placeholder="FAX">
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            <input type="text" class="form-control" placeholder="Emergency Contact Name">
                        </div>
                        <div class="form-group col-md-6">
                            <input type="text" class="form-control" placeholder="Emergency Contact Number">
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            <input type="text" class="form-control" placeholder="Name of Club">
                        </div>
                        <div class="form-group col-md-6">
                            <select class="form-control">
                                <option value="value">Blood Group</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            <label style="margin-bottom:10px;">CPR Copy</label>
                            <input type="file" class="form-control">
                        </div>
                        <div class="form-group col-md-6">
                            <label style="margin-bottom:10px;">Medical Form</label>
                            <input type="file" class="form-control">
                        </div>
                    </div>

                    <h3>Consent Statement for Applicants Under 18 Years</h3>

                    <br /><br />

                    <div class="row">
                        <div class="form-group col-md-6">
                            <input type="text" class="form-control" placeholder="Full Name">
                        </div>

                        <div class="form-group col-md-6">
                            <input type="text" class="form-control" placeholder="CPR Number">
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            <label style="margin-bottom:10px;">Parents CPR Copy</label>
                            <input type="file" class="form-control">
                        </div>
                    </div>

                    <p>
                        I am the parent / guardian of the above-named minor who is under
                        18 years old. I have read this document and understand its
                        contents. I consent to the minor attending / participating in the event
                        at his / her own risk.
                    </p>



                    <button type="submit" class="btn btn-primary payment-btn">SUBMIT FORM</button>
                </form>
            </div>
        </div>

    </div>
</section>


