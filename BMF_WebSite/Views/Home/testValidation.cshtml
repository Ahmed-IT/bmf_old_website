@model BMF_WebSite.Models.eSportRegForm
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title></title>

    <link href="~/Content/plugins/jquery-ui/jquery-ui.css" rel="stylesheet" />
    <link href="~/Content/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    @*@using (Html.BeginForm("eSport", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {*@

    <form id="eSport" asp-controller="Home" asp-action="eSport">
        <div class="row">
            <div class="form-group col-md-4">
                <label style="font-family:LatoB;">CPR Number <b style="color: red;">*</b></label>
                @Html.TextBoxFor(u => u.CPR, new { @class = "form-control", @required = "required", @placeholder = "Required Field" })
                @Html.ValidationMessageFor(model => model.CPR, "", new { @class = "text-danger" })
            </div>
            <div class="form-group col-md-4">
                <label style="font-family:LatoB;">First Name <b style="color: red;">*</b></label>
                @Html.TextBoxFor(u => u.FirstName, new { @class = "form-control", @required = "required", @placeholder = "Required Field" })
                @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
            </div>
            <div class="form-group col-md-4">
                <label style="font-family:LatoB;">Middle Name <b style="color: red;">*</b></label>
                @Html.TextBoxFor(u => u.MiddleName, new { @class = "form-control", @required = "required", @placeholder = "Required Field" })
                @Html.ValidationMessageFor(model => model.MiddleName, "Please enter your middle name", new { @class = "text-danger" })
            </div>
            <div class="form-group col-md-4">
                <label style="font-family:LatoB;">Last Name <b style="color: red;">*</b></label>
                @Html.TextBoxFor(u => u.LastName, new { @class = "form-control", @required = "required", @placeholder = "Required Field" })
                @Html.ValidationMessageFor(model => model.LastName, "Please enter your last name", new { @class = "text-danger" })
            </div>
            <div class="form-group col-md-4">
                <label style="font-family:LatoB;">Nationality <b style="color: red;">*</b></label>
                @Html.DropDownListFor(model => model.CountryId, new SelectList(ViewBag.Countries, "ID", "Name"), "Select Nationality", new { @class = "form-control", @required = "required" })
                @Html.ValidationMessageFor(model => model.CountryId, "Please enter your nationality", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row">
            <div class="form-group col-md-3">
                <label style="font-family:LatoB;">House Number <b style="color: red;">*</b></label>
                @Html.TextBoxFor(u => u.HouseNumber, new { @class = "form-control", @required = "required", @placeholder = "Required Field" })
                @Html.ValidationMessageFor(model => model.HouseNumber, "Please enter your house number", new { @class = "text-danger" })
            </div>
            <div class="form-group col-md-3">
                <label style="font-family:LatoB;">Road Number <b style="color: red;">*</b></label>
                @Html.TextBoxFor(u => u.RoadNumber, new { @class = "form-control", @required = "required", @placeholder = "Required Field" })
                @Html.ValidationMessageFor(model => model.RoadNumber, "Please enter your road number", new { @class = "text-danger" })
            </div>
            <div class="form-group col-md-3">
                <label style="font-family:LatoB;">Block Number <b style="color: red;">*</b></label>
                @Html.TextBoxFor(u => u.BlockNumber, new { @class = "form-control", @required = "required", @placeholder = "Required Field" })
                @Html.ValidationMessageFor(model => model.BlockNumber, "Please enter your block number", new { @class = "text-danger" })
            </div>
            <div class="form-group col-md-3">
                <label style="font-family:LatoB;">City <b style="color: red;">*</b></label>
                @Html.TextBoxFor(u => u.City, new { @class = "form-control", @required = "required", @placeholder = "Required Field" })
                @Html.ValidationMessageFor(model => model.City, "Please enter your city", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row">
            <div class="form-group col-md-6">
                <label style="font-family:LatoB;">Place of Birth <b style="color: red;">*</b></label>
                @Html.TextBoxFor(u => u.PlaceOfBirth, new { @class = "form-control", @required = "required", @placeholder = "Required Field" })
                @Html.ValidationMessageFor(model => model.PlaceOfBirth, "Please enter your place of birth", new { @class = "text-danger" })
            </div>
            <div class="form-group col-md-6">
                <label style="font-family:LatoB;">Date of Birth <b style="color: red;">*</b></label>
                @Html.TextBoxFor(u => u.DateOfBirth, new { @class = "form-control", @required = "required", @placeholder = "Required Field", @type = "date" })
                @Html.ValidationMessageFor(model => model.DateOfBirth, "Please enter your date of birth", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row">
            <div class="form-group col-md-6">
                <label style="font-family:LatoB;">Mobile Number <b style="color: red;">*</b></label>
                @Html.TextBoxFor(u => u.MobileNumber, new { @class = "form-control", @required = "required", @placeholder = "Required Field" })
                @Html.ValidationMessageFor(model => model.MobileNumber, "Please enter your mobile number", new { @class = "text-danger" })
            </div>
            <div class="form-group col-md-6">
                <label style="font-family:LatoB;">Email Address <b style="color: red;">*</b></label>
                @Html.TextBoxFor(u => u.EmailAddress, new { @class = "form-control", @required = "required", @placeholder = "Required Field" })
                @Html.ValidationMessageFor(model => model.EmailAddress, "Please enter your email address", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row">
            <div class="form-group col-md-6">
                <label style="font-family:LatoB;">PSN ID <b style="color: red;">*</b></label>
                @Html.TextBoxFor(u => u.PSN, new { @class = "form-control", @required = "required", @placeholder = "Required Field" })
                @Html.ValidationMessageFor(model => model.PSN, "Please enter your PSN ID", new { @class = "text-danger" })
            </div>
            <div class="form-group col-md-6">
                <label style="font-family:LatoB;">Instagram Username</label>
                @Html.TextBoxFor(u => u.Instagram, new { @class = "form-control", @placeholder = "" })
                Instagram account will be used to tag you on Instagram posts
            </div>
        </div>

        <div class="row">
            <div class="form-group col-md-6">
                <label style="font-family:LatoB;">Facebook Username</label>
                @Html.TextBoxFor(u => u.Facebook, new { @class = "form-control", @placeholder = "" })
                Instagram account will be used to tag you on Facebook posts
            </div>
            <div class="form-group col-md-6">
                <label style="font-family:LatoB;">Racing Mode</label>
                @Html.DropDownListFor(model => model.RacingMode, new SelectList(ViewBag.RacingMode, "Value", "Text"), "Select Mode", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.RacingMode, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row">
            <div class="form-group col-md-6">
                <label style="font-family:LatoB;">Most Racing Game Played</label>
                @Html.TextBoxFor(u => u.MotorsportGame, new { @class = "form-control", @placeholder = "" })
                @Html.ValidationMessageFor(model => model.MotorsportGame, "", new { @class = "text-danger" })
            </div>
            <div class="form-group col-md-6">
                <label style="font-family:LatoB;">Other Motorsport Participation</label>
                @Html.TextBoxFor(u => u.OtherMotorsport, new { @class = "form-control", @placeholder = "" })
                @Html.ValidationMessageFor(model => model.OtherMotorsport, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row">
            <div class="form-group col-md-6">
                <label style="font-family:LatoB;">CPR Copy <b style="color: red;">*</b></label>
                @Html.TextBoxFor(u => u.CPRFile, new { @class = "form-control", @type = "file", @required = "required" })
                @Html.ValidationMessageFor(model => model.CPRFile, "Please upload you cpr copy", new { @class = "text-danger" })
            </div>
            <div class="form-group col-md-6">
                <label style="font-family:LatoB;">Photo <b style="color: red;">*</b></label>
                @Html.TextBoxFor(u => u.Photo, new { @class = "form-control", @type = "file", @required = "required" })
                @Html.ValidationMessageFor(model => model.Photo, "Please upload your photo", new { @class = "text-danger" })
                <br />
                an example applicable to the requirements
                <br />
                <img src="~/Content/images/PhotoSample.png" style="height:150px;" />
            </div>
        </div>

        <h3>Consent Statement for Applicants Under 18 Years</h3>

        <br />

        <div class="form-group" style="color:black; font-size:16px; color:red;">
            @Html.CheckBoxFor(model => model.IsUnder18)
            Please check the box if you are under 18
            <br />
            @Html.ValidationMessageFor(model => model.IsUnder18, "", new { @class = "text-danger" })
        </div>

        <div class="row">
            <div class="form-group col-md-6">
                @Html.TextBoxFor(u => u.ParentFullName, new { @class = "form-control", @type = "text", @placeholder = "Parent Full Name" })
                @Html.ValidationMessageFor(model => model.ParentFullName, "", new { @class = "text-danger" })
            </div>

            <div class="form-group col-md-6">
                @Html.TextBoxFor(u => u.ParentCPR, new { @class = "form-control", @type = "text", @placeholder = "Parent CPR Number" })
                @Html.ValidationMessageFor(model => model.ParentCPR, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row">
            <div class="form-group col-md-6">
                <label style="margin-bottom:10px;">Parents CPR Copy</label>
                @Html.TextBoxFor(u => u.ParentCPRFile, new { @class = "form-control", @type = "file" })
                @Html.ValidationMessageFor(model => model.ParentCPRFile, "", new { @class = "text-danger" })

            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="form-group" style="color:black; font-size:16px;">
                    @*<input name="ChkAccept" required="" type="checkbox">*@
                    @Html.CheckBoxFor(model => model.ChkAccept, new { @required = "required" })
                    I hereby accept the  <a href="~/docs/RulesRegs/BEGTC_Regulations_V2.1_FINAL.pdf" target="_blank" style="color:Red;">rules / regulations</a> and confirm that the information submitted on this registration page is true & correct.  <font style="color:red; font-weight:bold;">*</font>
                    <br />
                    @Html.ValidationMessageFor(model => model.ChkAccept, "Please accept the rules and regs check box", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <input class="btn btn-primary payment-btn" type="submit" value="SUBMIT FORM">
        <br />
    </form>


            @*}*@

    </body>
</html>

<script src="~/Scripts/jquery-3.6.0.js"></script>
<script src="~/Scripts/jquery.validate.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.js"></script>
<script type="text/javascript">
    $.validator.setDefaults({
        highlight: function (element) {
            $(element).closest('.form-group').removeClass('has-success has-feedback').addClass('has-error has-feedback'); // red highlighting
            $(element).closest('.form-group').find('.form-control-feedback').removeClass('glyphicon-ok').addClass('glyphicon-remove'); // red cross glyphicon
        },
        unhighlight: function (element) {
            $(element).closest('.form-group').removeClass('has-error has-feedback').addClass('has-success has-feedback'); // green highlighting
            $(element).closest('.form-group').find('.form-control-feedback').removeClass('glyphicon-remove').addClass('glyphicon-ok'); // green tick glyphicon
        }
    });
</script>