
@{
    ViewBag.Title = "ContactUs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section id="banner-2">
    <div class="container">
        <div class="row">
            <div class="col-lg-7 col-md-7 col-sm-12 col-10 mobile-auto">
                <div class="luanch">
                    <div class="coundown_res">
                        <div class="row">
                            <br />
                            <br />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-md-1"></div>
            <div class="col-lg-3 col-md-4">

            </div>
        </div>
    </div>
</section>

<section id="event">
    <div class="container zindex">
        <div class="row">
            <div class="col-lg-12 speaker-heading">
                <h3>CONTACT US</h3>
                <div class="header-style"></div>
            </div>
        </div>

        <br /><br />

        <div class="row">
            <div class="col-lg-5 about-txt">
                <p style="font-size:16px; font-family:LatoR;">
                    If you wish to contact the Bahrain Motor Federation (BMF) on media or commercial matters, please contact us.

                    <h3 style="color:red;">BAHRAIN MOTOR FEDERATION</h3>
                    <br />
                    P.O. Box 54336, Manama,
                    <br />
                    Kingdom of Bahrain

                    <br /><br />

                    <i class="fa fa-phone"> <font style="font-family: LatoR;">+973 17 45 20 00</font></i>
                    <br />
                    <i class="fa fa-fax"> <font style="font-family: LatoR;">+973 17 45 20 20</font></i>
                    <br />
                    <i class="fa fa-envelope"> <font style="font-family: LatoR;">info@bmf.com.bh</font></i>
                </p>

            </div>
            <div class="col-lg-7">
                <h3 style="font-family:FjallaOneR;">Send Us Message</h3>
                <br /><br />
                <div class="row">
                    <div class="form-group col-md-6">
                        <input type="text" class="form-control" placeholder="Full Name">
                    </div>
                    <div class="form-group col-md-6">
                        <input type="text" class="form-control" placeholder="Email Address">
                    </div>
                </div>

                <div class="row">
                    <div class="form-group col-md-12">
                        <input type="text" class="form-control" placeholder="Subject">
                    </div>
                </div>

                <div class="row">
                    <div class="form-group col-md-12">
                        <textarea class="form-control" style="height:100px;" placeholder="Message" rows="20"></textarea>
                    </div>
                </div>

                <button class="btn buttonStyle">Submit Form</button>

            </div>


        </div>

        <br /><br />

              <h3 style="font-family:FjallaOneR;">Our Location</h3>
              <br /><br />
        <iframe src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d14340.240340546594!2d50.511295!3d26.03159!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0xb08bbfbdc59c2dc!2sBahrain%20International%20Circuit!5e0!3m2!1sen!2sus!4v1611432510248!5m2!1sen!2sus" height="450" frameborder="0" style="border:0; width:100%;" allowfullscreen="" aria-hidden="false" tabindex="0"></iframe>

    </div>
</section>

