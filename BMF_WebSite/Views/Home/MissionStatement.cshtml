
@{
    ViewBag.Title = "MissionStatement";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section id="banner-2">
    <div class="container">
        <div class="row">
            <div class="col-lg-7 col-md-7 col-sm-12 col-10 mobile-auto">
                <div class="luanch">
                    <div class="coundown_res">
                        <div class="row">
                            <br />
                            <br />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-md-1"></div>
            <div class="col-lg-3 col-md-4">

            </div>
        </div>
    </div>
</section>

<section id="organize_2">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-sm-6 org-item sm-style-h">
                <h3 style="font-family:FjallaOneR;">
                    <a href='@Url.Action("AboutUs","Home",null)'>HISTORY</a>
                </h3>
            </div>
            
            <div class="col-lg-3 col-sm-6 org-item sm-style-h">
                <h3 style="font-family:FjallaOneR;">
                    <a href='@Url.Action("BoardMembers","Home",null)'>BOARD MEMBERS</a>
                </h3>
            </div>
        </div>
    </div>
</section>


<section id="event">
    <div class="container zindex">
        <div class="row">
            <div class="col-lg-12 speaker-heading">
                <h3>MISSION STATEMENT</h3>
                <div class="header-style"></div>
            </div>
        </div>

        <br /><br />

        <div class="row">
            <div class="col-lg-12 event-header mobile-t-p">
                <div class="row">
                    <div class="col-lg-4" style="text-align:right;">
                        <h4>
                            BMF 
                            <br />
                            MISSION
                            <br />
                            STATEMENT
                        </h4>
                    </div>

                    <div class="col-lg-6">
                        <p style="font-size:32px;">"To promote the safety and soundness of motoring and motorsport in the Kingdom of Bahrain".</p>
                    </div>
                </div>
                
            </div>
        </div>

        <div class="row" style="margin-top:30px;">
            <div class="col-lg-12 event-header mobile-t-p" style="text-align:center;">
                <h4 style="color:black">BMF OBJECTIVES </h4>
            </div>

            <div class="col-lg-12">
                <div class="row">
                    <div class="col-lg-6 col-sm-6">
                        <div class="about-item">
                            <span>01</span>
                            <p>Our goal is to ensure safe and fair motorsport competition.</p>
                        </div>
                    </div>
                    <div class="col-lg-6 col-sm-6">
                        <div class="about-item">
                            <span>02</span>
                            <p>Exercise the sporting power as "ASN" for Bahrain in accordance with the International Sporting Code and such instructions and directions as may be received from the FIA.</p>
                        </div>
                    </div>
                    <div class="col-lg-6 col-sm-6">
                        <div class="about-item">
                            <span>03</span>
                            <p>Encourage, manage, regulate, and advance motorsport in Bahrain upholding the values and spirit of true competitive sport and fairness.</p>
                        </div>
                    </div>
                    <div class="col-lg-6 col-sm-6">
                        <div class="about-item">
                            <span>04</span>
                            <p>
                                Ensure safety is maximized in conduct of motorsport.
                            </p>
                        </div>
                    </div>

                    <div class="col-lg-6 col-sm-6">
                        <div class="about-item">
                            <span>05</span>
                            <p>Formulate, issue, interpret, implement, enforce, and amend as required the GCR (General Competition Regulations) as necessary for the control and conduct of motorsport in Bahrain.</p>
                        </div>
                    </div>

                    <div class="col-lg-6 col-sm-6">
                        <div class="about-item">
                            <span>06</span>
                            <p>
                                Issue competition licences, officials licences, and event permits in accordance with the Code and the GCR.
                            </p>
                        </div>
                    </div>

                    <div class="col-lg-6 col-sm-6">
                        <div class="about-item">
                            <span>07</span>
                            <p>Support and cooperate with any club, association, organization, group or individual whose activities or objectives are similar to those of BMF or which advance the cause of motorsport in Bahrain.</p>
                        </div>
                    </div>

                    <div class="col-lg-6 col-sm-6">
                        <div class="about-item">
                            <span>08</span>
                            <p>Publish annual Bahrain motorsport calendar of events and arrange listing of international events on the FIA calendar.</p>
                        </div>
                    </div>

                    <div class="col-lg-6 col-sm-6">
                        <div class="about-item">
                            <span>09</span>
                            <p>Establish and operate the judicial system for motorsport in Bahrain.</p>
                        </div>
                    </div>

                    <div class="col-lg-6 col-sm-6">
                        <div class="about-item">
                            <span>10</span>
                            <p>
                                Promote programs aimed at safety, training, and education in motoring and motorsport.
                            </p>
                        </div>
                    </div>

                    <div class="col-lg-6 col-sm-6">
                        <div class="about-item">
                            <span>11</span>
                            <p>
                                Promote and be engaged in road safety.
                            </p>
                        </div>
                    </div>

                    <div class="col-lg-6 col-sm-6">
                        <div class="about-item">
                            <span>12</span>
                            <p>
                                Have regard for public interest, environment protection, and other national causes in the operations of BMF.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
