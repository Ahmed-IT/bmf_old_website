@model BMF_WebSite.Models.ClsLicForm
@{
    ViewBag.Title = "MarshalsLicense";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/plugins/jquery-ui/jquery-ui.css" rel="stylesheet" />

<script src="~/Scripts/jquery-3.6.0.js"></script>
<script src="~/Content/plugins/jquery-ui/jquery-ui.js"></script>
<script src="https://ajax.aspnetcdn.com/ajax/jquery.validate/1.14.0/jquery.validate.min.js"></script>
<script src="https://ajax.aspnetcdn.com/ajax/mvc/5.2.3/jquery.validate.unobtrusive.min.js"></script>

<section id="banner-2">
    <div class="container">
        <div class="row">
            <div class="col-lg-7 col-md-7 col-sm-12 col-10 mobile-auto">
                <div class="luanch">
                    <div class="coundown_res">
                        <div class="row">
                            <br />
                            <br />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-md-1"></div>
            <div class="col-lg-3 col-md-4">

            </div>
        </div>
    </div>
</section>

<section id="organize_2">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-sm-6 org-item sm-style-h">
                <h3 style=" font-family: DinoB;">
                    <a href='@Url.Action("CdpApplication","Services",null)'>CPD APPLICATION</a>
                </h3>
            </div>
            <div class="col-lg-3 col-sm-6 org-item">
                <h3 style=" font-family: DinoB;">
                    <a href='@Url.Action("CompetitionLicense","Services",null)'>COMPETITION LICENSE</a>
                </h3>

            </div>
            <div class="col-lg-3 col-sm-6 org-item">
                <h3 style=" font-family: DinoB;">
                    <a href='@Url.Action("MarshalsLicense","Services",null)'>MARSHALS LICENSE</a>
                </h3>

            </div>
        </div>
    </div>
</section>

<section id="schedule">
    <div class="container zindex">
        <div class="row">
            <div class="col-lg-12 speaker-heading">
                <h3>Marshals License Form</h3>
            </div>
        </div>

        <br /><br />

        <div class="col-lg-12">
            <div class="purchase-box" style=" font-family: DinoR;">
                <h4>Application Form for Marshals Licence</h4>

                @try
                {
                    if (TempData["Status"] != null)
                    {
                        if (TempData["Status"].ToString() == "Exist")
                        {
                            <script>
                                $(document).ready(function () {
                                    // Handler for .ready() called.
                                    $('html, body').animate({
                                        scrollTop: $('#divRegForm').offset().top
                                    }, 'slow');
                                });
                            </script>

                            <br /><br />
                            <div class="alert alert-danger" role="alert" style="text-align:center; color:red; font-size:18px;">
                                Your information already exist and enrolled.
                            </div>
                        }
                        else
                        {
                            <script>
                                $(document).ready(function () {
                                    // Handler for .ready() called.
                                    $('html, body').animate({
                                        scrollTop: $('#divRegForm').offset().top
                                    }, 'slow');
                                });
                            </script>

                            <br /><br />
                            <div class="alert alert-danger" role="alert" style="text-align:center; color:red; font-size:18px;">
                                Error in submitting your form, please check your information.
                            </div>
                        }
                    }
                }
                catch (global::System.Exception)
                {

                }

                @using (Html.BeginForm("CompetitionLicense", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="form-group col-md-6">
                            <label style="color:red;font-family:LatoB;">* Required Filed</label>
                            @Html.DropDownListFor(model => model.LicenseRequestType, new SelectList(ViewBag.LicenseType, "Value", "Text"), "Select Application Type", new { @class = "form-control", @required = "required" })
                            @Html.ValidationMessageFor(model => model.LicenseRequestType, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group col-md-6">
                            <label style="color:red;font-family:LatoB;">* Required Filed</label>
                            @Html.TextBoxFor(u => u.CPR, new { @class = "form-control", @required = "required", @placeholder = "CPR Number" })
                            @Html.ValidationMessageFor(model => model.CPR, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-3">
                            <label style="color:red;font-family:LatoB;">* Required Filed</label>
                            @Html.TextBoxFor(u => u.FirstName, new { @class = "form-control", @required = "required", @placeholder = "First Name" })
                            @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group col-md-3">
                            <label style="color:red;font-family:LatoB;">* Required Filed</label>
                            @Html.TextBoxFor(u => u.MiddleName, new { @class = "form-control", @required = "required", @placeholder = "Middle Name" })
                            @Html.ValidationMessageFor(model => model.MiddleName, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group col-md-3">
                            <label style="color:red;font-family:LatoB;">* Required Filed</label>
                            @Html.TextBoxFor(u => u.LastName, new { @class = "form-control", @required = "required", @placeholder = "Last Name" })
                            @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group col-md-3">
                            <label style="color:red;font-family:LatoB;">* Required Filed</label>
                            @Html.DropDownListFor(model => model.CountryId, new SelectList(ViewBag.Countries, "ID", "Name"), "Select Nationality", new { @class = "form-control", @required = "required" })
                            @Html.ValidationMessageFor(model => model.CountryId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-3">
                            <label style="color:red;font-family:LatoB;">* Required Filed</label>
                            @Html.TextBoxFor(u => u.HouseNumber, new { @class = "form-control", @required = "required", @placeholder = "House/Building" })
                            @Html.ValidationMessageFor(model => model.HouseNumber, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group col-md-3">
                            <label style="color:red;font-family:LatoB;">* Required Filed</label>
                            @Html.TextBoxFor(u => u.RoadNumber, new { @class = "form-control", @required = "required", @placeholder = "Road Number" })
                            @Html.ValidationMessageFor(model => model.RoadNumber, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group col-md-3">
                            <label style="color:red;font-family:LatoB;">* Required Filed</label>
                            @Html.TextBoxFor(u => u.BlockNumber, new { @class = "form-control", @required = "required", @placeholder = "Block Number" })
                            @Html.ValidationMessageFor(model => model.BlockNumber, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group col-md-3">
                            <label style="color:red;font-family:LatoB;">* Required Filed</label>
                            @Html.TextBoxFor(u => u.City, new { @class = "form-control", @required = "required", @placeholder = "City" })
                            @Html.ValidationMessageFor(model => model.City, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            <label style="color:red;font-family:LatoB;">* Required Filed</label>
                            @Html.TextBoxFor(u => u.PlaceOfBirth, new { @class = "form-control", @required = "required", @placeholder = "Place of Birth" })
                            @Html.ValidationMessageFor(model => model.PlaceOfBirth, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group col-md-6">
                            <label style="color:red;font-family:LatoB;">* Required Filed</label>
                            @Html.TextBoxFor(u => u.DateOfBirth, new { @class = "form-control", @required = "required", @placeholder = "Date of Birth", @type = "date" })
                            @Html.ValidationMessageFor(model => model.DateOfBirth, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            <label style="color:red;font-family:LatoB;">* Required Filed</label>
                            @Html.TextBoxFor(u => u.MobileNumber, new { @class = "form-control", @required = "required", @placeholder = "Mobile Number" })
                            @Html.ValidationMessageFor(model => model.MobileNumber, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group col-md-6">
                            <label style="color:red;font-family:LatoB;">* Required Filed</label>
                            @Html.TextBoxFor(u => u.EmailAddress, new { @class = "form-control", @required = "required", @placeholder = "Email Address" })
                            @Html.ValidationMessageFor(model => model.EmailAddress, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            <label style="color:red;font-family:LatoB;">* Required Filed</label>
                            @Html.TextBoxFor(u => u.EmergencyName, new { @class = "form-control", @required = "required", @placeholder = "Emergency Contact Name" })
                            @Html.ValidationMessageFor(model => model.EmergencyName, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group col-md-6">
                            <label style="color:red;font-family:LatoB;">* Required Filed</label>
                            @Html.TextBoxFor(u => u.EmergencyNumber, new { @class = "form-control", @required = "required", @placeholder = "Emergency Contact Number" })
                            @Html.ValidationMessageFor(model => model.EmergencyNumber, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            <label style="color:red;font-family:LatoB;">* Required Filed</label>
                            @Html.DropDownListFor(model => model.BloodGroup, new SelectList(ViewBag.BloodGroup, "Value", "Text"), "Select Blood Group", new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.BloodGroup, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group col-md-6">
                            <label style="margin-bottom:10px;"><font style="color:red; font-family:LatoB;">*</font> Photo</label>
                            @Html.TextBoxFor(u => u.Photo, new { @class = "form-control", @type = "file", @required = "required" })
                            @Html.ValidationMessageFor(model => model.Photo, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            <label style="margin-bottom:10px;"><label style="margin-bottom:10px;"><font style="color:red; font-family:LatoB;">*</font> Photo</label> CPR Copy</label>
                            @Html.TextBoxFor(u => u.CPRFile, new { @class = "form-control", @type = "file", @required = "required" })
                            @Html.ValidationMessageFor(model => model.CPRFile, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary payment-btn">SUBMIT FORM</button>
                }
            </div>
        </div>
    </div>
</section>

<script src="~/Content/plugins/jquery-ui/jquery-ui.js"></script>
<script src="~/Content/plugins/moment/moment.min.js"></script>
<script>
    if ($('[type="date"]').prop('type') != 'date') {
        $('[type="date"]').datepicker(
            {
                changeMonth: true,
                changeYear: true,
                yearRange: '-60:+0',
                dateFormat: 'dd-M-yy'
            });
    }

</script>


