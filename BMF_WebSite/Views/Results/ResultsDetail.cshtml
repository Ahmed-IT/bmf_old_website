@model BMF_WebSite.ViewModels.ResultDetailsVM
@{
    ViewBag.Title = "ResultsDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section id="banner-2">
    <div class="container">
        <div class="row">
            <div class="col-lg-7 col-md-7 col-sm-12 col-10 mobile-auto">
                <div class="luanch">
                    <div class="coundown_res">
                        <div class="row">
                            <br />
                            <br />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-md-1"></div>
            <div class="col-lg-3 col-md-4">
            </div>
        </div>
    </div>
</section>

<section id="event">
    <div class="container zindex">
        <div class="row">
            <div class="col-lg-12 speaker-heading">
                <h3 style="font-family:DinoB;">Results & Standing</h3>
                <div class="header-style"></div>
            </div>
        </div>
        <br /><br />
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label style="color:red; font-family:DinoB;">Select Season</label>
                    <select class="form-control select_season">
                        @foreach (var item in Model.Seasons)
                        {
                            <option value="@item.ID">@item.Title</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label style="color: red; font-family: DinoB;">Select Round</label>
                    <select class="form-control select_round">
                        <option>Select a season ...</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label style="color: red; font-family: DinoB;">Select Session</label>
                    <select class="form-control select_session">
                        <option>Select a round ...</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <button style="margin-top: 30px; font-family: DinoB;" class="btn buttonStyle showResults">Show Results</button>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-md-6">
                <h4 style="margin-bottom: 20px; font-family: DinoR;">Championship Standing</h4>
                <table class="table table-striped table-responsive">
                    <thead>
                        <tr>
                            <th class="text-center" style="background-color: #E52F2F; color: white; font-family: DinoR;">Pos</th>
                            <th class="text-center" style="background-color: #E52F2F; color: white; font-family: DinoR;">Full Name</th>
                            <th class="text-center" style="background-color:#E52F2F; color:white; font-family:DinoR;">Total Points</th>
                        </tr>
                    </thead>
                    <tbody class="champResults">
                        <tr><td style="font-family: DinoB;" class="text-center" colspan="3">Click Show Results</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="col-md-6">
                <h4 style="margin-bottom: 20px; font-family: DinoR; ">
                    <span class="roundsessionResultsTitle">Round Title</span>
                </h4>

                <table class="table table-striped table-responsive">
                    <thead>
                        <tr>
                            <th class="text-center" style="background-color: #E52F2F; color: white; font-family: DinoR;">Pos</th>
                            <th class="text-center" style="background-color: #E52F2F; color: white; font-family: DinoR;">Full Name</th>
                            <th class="text-center" style="background-color: #E52F2F; color: white; font-family: DinoR;">Total Points</th>
                        </tr>
                    </thead>
                    <tbody class="roundsessionResults">
                        <tr><td style="font-family: DinoB;" class="text-center" colspan="3">Click Show Results</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section pagescripts{
    <script>
        $(document).ready(function () {
            $(document).on('change', '.select_season', function () {
                $('.select_round').children().remove().append("<option>Select a season ...</option>");
                $.ajax({
                    url: "@Url.Action("getRounds")",
                    data: { ID: @Model.ID , ID_Season: $('.select_season').val() },
                    dataType: "JSON",
                    success: function (result) {
                        $('.select_round').children().remove();
                        $.each(result, function (k, v) {
                            $('.select_round').append("<option value='" + v.ID + "'>" + v.Round_Number+"</option>");
                        });
                        $('.select_round').change();
                    }
                });
            });

            $(document).on('change', '.select_round', function () {
                $('.select_session').children().remove().append("<option>Select a round ...</option>");
                $.ajax({
                    url: "@Url.Action("getSessions")",
                    data: { ID: @Model.ID , ID_Season: $('.select_season').val(), ID_Round: $('.select_round').val() },
                    dataType: "JSON",
                    success: function (result) {
                        $('.select_session').children().remove();
                        $.each(result, function (k, v) {
                            $('.select_session').append("<option value='" + v.ID + "'>" + v.Title+"</option>");
                        });
                        $('.select_session').change();
                    }
                });
            });

            $(document).on('change', '.select_session', function () {
            });

            $(document).on('click', '.showResults', function () {
                $('.roundsessionResultsTitle').text($('.select_round option:selected').text() + " (" + $('.select_session option:selected').text() + ")");
                $('.champResults').children().remove().append('<tr><td style="font-family:DinoB;" class="text-center" colspan="3">Click Show Results</td></tr>');
                $('.roundsessionResults').children().remove().append('<tr><td style="font-family:DinoB;" class="text-center" colspan="3">Click Show Results</td></tr>');

                $.ajax({
                    url: "@Url.Action("getChampResults")",
                    data: { ID: @Model.ID , ID_Season: $('.select_season').val(), ID_Round: $('.select_round').val(), ID_Session: $('.select_session').val() },
                    dataType: "JSON",
                    success: function (result) {
                        $.each(result, function (k, v) {

                            $('.champResults').append("<tr><td style='font-family:DinoB;' class='text-center'>"+(k+1)+"</td><td style='font-family:DinoR;' class='text-center'>"+v.FullName+"</td><td style='font-family:DinoR;' class='text-center'>"+v.TotalPoints+"</td></tr>");
                        });
                    }
                });

                 $.ajax({
                    url: "@Url.Action("getRoundSessionResults")",
                    data: { ID: @Model.ID , ID_Season: $('.select_season').val(), ID_Round: $('.select_round').val(), ID_Session: $('.select_session').val() },
                    dataType: "JSON",
                    success: function (result) {
                        $.each(result, function (k, v) {
                            $('.roundsessionResults').append("<tr><td style='font-family:DinoB;' class='text-center'>"+(k+1)+"</td><td style='font-family:DinoR;' class='text-center'>"+v.FullName+"</td><td style='font-family:DinoR;' class='text-center'>"+v.TotalPoints+"</td></tr>");
                        });
                    }
                });
            });

            $('.select_season').change();
        });
    </script>
}