@model List<BMF_WebSite.Models.ClsGalleryCategory>
@{
    ViewBag.Title = "Gallery";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<section id="banner-2">
    <div class="container">
        <div class="row">
            <div class="col-lg-7 col-md-7 col-sm-12 col-10 mobile-auto">
                <div class="luanch">
                    <div class="coundown_res">
                        <div class="row">
                            <br />
                            <br />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-md-1"></div>
            <div class="col-lg-3 col-md-4">

            </div>
        </div>
    </div>
</section>

<section id="event">
    <div class="container zindex">
        <div class="row">
            <div class="col-lg-12 speaker-heading">
                <h3 style="font-family: DinoB;">GALLERY</h3>
                <div class="header-style"></div>
            </div>
        </div>

        <br /><br />

              <div class="row">
                  @if (Model.Count > 0)
                  {
                      foreach (var item in Model)
                      {
                          <div class="col-md-4" style="margin-bottom:20px;">
                              <div class="card border-0 rounded-0 bg-dark text-white">
                                  <a style="z-index: 999; cursor:pointer;" href="@Url.Action("GalleryImages","Gallery",new { ID = item.ID})"><img src="@item.Image_URL" class="card-img"></a>
                                  
                              </div>
                          </div>
                      }
                  }

              </div>


    </div>
</section>


