@{ Layout = null; }
<div class="header-container box no-border text-center">
    <div class="row">
        <div class="col-sm-12 header-title">
            <h2 class="headline text-white"><i class="margin-r-5 fa fa-ban"></i></h2>
            <h2 class="text-white">@ViewBag.Title</h2>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12 header-text text-white">
            <h4>
                @ViewBag.Message
                <br />
                <br />
            </h4>
            <div class="form-group">
                <a href="/" class="btn btn-app bg-blue-bg text-white"><i class="fa fa-home"></i> Go Home</a>
            </div>
        </div>
    </div>
</div>