@{
    Layout = FixedTerms.System_ViewStart;
}
<div class="header-container box no-border">
    <div class="container">
        <div class="row">
            <div class="col-sm-12 header-title">
                <h2 class="headline text-danger"><i class="margin-r-5 fa fa-warning"></i>@ViewBag.Code</h2>
                <h2 class="text-danger">@ViewBag.Title</h2>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12 header-text text-danger">
                <h4>
                    @ViewBag.Message
                </h4>
                <div class="form-group">
                    <a href="/" class="btn btn-app btn-primary"><i class="fa fa-home"></i> Go Home</a>
                    <button onclick="history.go(-1);" class="btn btn-app btn-primary"><i class="fa fa-history"></i> Go Back</button>
                </div>
            </div>
        </div>
    </div>
</div>