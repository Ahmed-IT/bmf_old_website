@if (ViewBag.ErrorID != null)
{
    <div class='alert alert-danger alert-dismissable'>
        @if (ViewBag.ErrorDispose)
        {
            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
        }
        <h4><i class='margin-r-5 fa fa-ban'></i>@Html.Raw(ViewBag.ErrorTitle)</h4>
        @if (ViewBag.ErrorMsg != "")
        {
            <p>@Html.Raw(ViewBag.ErrorMsg)</p>
        }
        <p>If this problem persists, please contact system administrator (reference error #@ViewBag.ErrorID).</p>
    </div>
}
