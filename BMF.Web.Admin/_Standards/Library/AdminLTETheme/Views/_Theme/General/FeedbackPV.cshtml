@if (ViewBag.PVErrorID != null)
{
    <div class='alert alert-danger alert-dismissable'>
        @if (ViewBag.PVErrorDispose)
        {
            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
        }
        <h4><i class='margin-r-5 fa fa-ban'></i>@Html.Raw(ViewBag.PVErrorTitle)</h4>
        @if (ViewBag.PVErrorMsg != "")
        {
            <p>@Html.Raw(ViewBag.PVErrorMsg)</p>
        }
        <p>If this problem persists, please contact system administrator (reference error #@ViewBag.PVErrorID).</p>
    </div>
}
