<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:prism="http://prismlibrary.com" xmlns:navigationdrawer="clr-namespace:Syncfusion.SfNavigationDrawer.XForms;assembly=Syncfusion.SfNavigationDrawer.XForms" xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms" xmlns:ffimageloading="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms" xmlns:local="clr-namespace:BMF_NewApp.Views" xmlns:Syncfusion="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms" xmlns:syncfusion="clr-namespace:Syncfusion.SfBarcode.XForms;assembly=Syncfusion.SfBarcode.XForms" xmlns:carousel="clr-namespace:Syncfusion.SfCarousel.XForms;assembly=Syncfusion.SfCarousel.XForms" xmlns:sflistview="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms" xmlns:sfavatar="clr-namespace:Syncfusion.XForms.AvatarView;assembly=Syncfusion.Core.XForms" NavigationPage.HasNavigationBar="false"
             Title="{Binding Title}" BackgroundColor="#D90000"
             prism:ViewModelLocator.AutowireViewModel="True"
             x:Class="BMF_NewApp.Views.MyIDsPage" x:Name="MyIDsPage1">

    <AbsoluteLayout Padding="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <StackLayout AbsoluteLayout.LayoutBounds="0, 0, 1, 1" AbsoluteLayout.LayoutFlags="All" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

            <navigationdrawer:SfNavigationDrawer x:Name="navigationDrawer" DrawerHeaderHeight="200" DrawerWidth ="300" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" DrawerFooterHeight="30">
                <navigationdrawer:SfNavigationDrawer.ContentView>
                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid x:Name="mainContentView" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="80"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackLayout Grid.Row="0" BackgroundColor="#D90000" Orientation="Horizontal">
                                <Grid HorizontalOptions="FillAndExpand" Padding="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Margin="0,30,0,0" Grid.Column="0" x:Name="hamburgerButton" HeightRequest="50" WidthRequest="50" HorizontalOptions="Start" FontSize="20" BackgroundColor="#D90000" Image="burgerIcon" Clicked="hamburgerButton_Clicked"/>
                                </Grid>
                            </StackLayout>

                            <Grid Margin="0,-6,0,0" Padding="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="1">
                                <sflistview:SfListView  ItemsSource="{Binding MyLicenseList}"
                                                        ItemSpacing="0"
                                                        SelectionMode="Single"
                                                        SelectionBackgroundColor="Transparent"
                                                        HeaderSize="80"
                                                        ItemSize="780"
                                                        HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
                                                        Padding="0"
                                                        Margin="0">
                                    <sflistview:SfListView.HeaderTemplate>
                                        <DataTemplate>
                                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="#D90000">
                                                <Label Text="My ID" FontSize="Title" FontFamily="MontserratBold" TextColor="White" HorizontalOptions="Center" VerticalOptions="CenterAndExpand"></Label>
                                            </StackLayout>
                                        </DataTemplate>
                                    </sflistview:SfListView.HeaderTemplate>
                                    <sflistview:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <ViewCell>
                                                <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="#f5f5f5">
                                                    <border:SfBorder Margin="20"
   BorderColor="#C7C7C7"
   BackgroundColor="#E3E3E3" 
   HorizontalOptions="FillAndExpand" 
   VerticalOptions="FillAndExpand"
   BorderWidth="1" CornerRadius="10">

                                                        <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                                                            <Label Grid.Column="0" Margin="0,20,0,10" Text="{Binding LicenseType.LicenseTitleFull}" FontSize="Large" FontFamily="MontserratBold" HorizontalOptions="CenterAndExpand"></Label>

                                                            <BoxView HeightRequest="1" BackgroundColor="#C7C7C7" HorizontalOptions="FillAndExpand"></BoxView>

                                                            <Grid VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Margin="20,20,20,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition></ColumnDefinition>
                                                                    <ColumnDefinition></ColumnDefinition>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="120"></RowDefinition>
                                                                    <RowDefinition Height="80"></RowDefinition>
                                                                    <RowDefinition Height="40"></RowDefinition>
                                                                    <RowDefinition Height="40"></RowDefinition>
                                                                    <RowDefinition Height="40"></RowDefinition>
                                                                    <RowDefinition Height="40"></RowDefinition>
                                                                </Grid.RowDefinitions>

                                                                <sfavatar:SfAvatarView Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" IsClippedToBounds="True" ContentType="Custom" AvatarColorMode="LightBackground" ImageSource="{Binding Profile.Photo_URL}"
                                                    HorizontalOptions="Center" HeightRequest="120" CornerRadius="60" WidthRequest="120" />

                                                                <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2">
                                                                    <Label HorizontalOptions="Center" VerticalOptions="End" TextColor="Black" FontFamily="MontserratMedium" FontSize="Large" Margin="10,10,0,0" Text="{Binding Profile.FullName}"></Label>
                                                                    <Label HorizontalOptions="Center" VerticalOptions="End" TextColor="Black" FontFamily="MontserratMedium" FontSize="Large" Margin="10,0,0,0" Text="{Binding License_Number_Full}"></Label>
                                                                </StackLayout>

                                                                <Label Margin="0,10,0,0" Grid.Column="0" Grid.Row="2" HorizontalOptions="Start" TextColor="Black" FontFamily="MontserratMedium" FontSize="Medium" Text="CPR Number"></Label>
                                                                <Label Margin="0,10,0,0" Grid.Column="1" Grid.Row="2" HorizontalOptions="End" TextColor="Black" FontFamily="MontserratMedium" FontSize="Medium" Text="{Binding Profile.CPR}"></Label>

                                                                <Label Margin="0,10,0,0" Grid.Column="0" Grid.Row="3" HorizontalOptions="Start" TextColor="Black" FontFamily="MontserratMedium" FontSize="Medium" Text="Expire Date"></Label>
                                                                <Label Margin="0,10,0,0" Grid.Column="1" Grid.Row="3" HorizontalOptions="End" TextColor="Black" FontFamily="MontserratMedium" FontSize="Medium" Text="{Binding Expire_Date, StringFormat=' {0:dd MMM yyyy}'}"></Label>

                                                                <Label Margin="0,10,0,0" Grid.Column="0" Grid.Row="4" HorizontalOptions="Start" TextColor="Black" FontFamily="MontserratMedium" FontSize="Medium" Text="Blood Group"></Label>
                                                                <Label Margin="0,10,0,0" Grid.Column="1" Grid.Row="4" HorizontalOptions="End" TextColor="Black" FontFamily="MontserratMedium" FontSize="Medium" Text="{Binding Profile.Blood_Group}"></Label>

                                                                <Label Margin="0,10,0,0" Grid.Column="0" Grid.Row="5" HorizontalOptions="Start" TextColor="Black" FontFamily="MontserratMedium" FontSize="Medium" Text="Date of Birth"></Label>
                                                                <Label Margin="0,10,0,0" Grid.Column="1" Grid.Row="5" HorizontalOptions="End" TextColor="Black" FontFamily="MontserratMedium" FontSize="Medium" Text="{Binding Profile.DateOfBirth, StringFormat=' {0:dd MMM yyyy}'}"></Label>


                                                            </Grid>

                                                            <StackLayout BackgroundColor="Transparent">
                                                                <syncfusion:SfBarcode BackgroundColor="Transparent" ShowText="False" Margin="0" Text="{Binding License_Number}" WidthRequest="180" HeightRequest="180" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Symbology="QRCode"/>

                                                                <Button Grid.Column="1" Command="{Binding Path=BindingContext.ViewLicenseCommand, Source={x:Reference Name=MyIDsPage1}}" CommandParameter="{Binding .}" Margin="20,0,20,20" Text="View License" FontSize="Small" FontFamily="MontserratMedium" BackgroundColor="#D90000" TextColor="White" HeightRequest="40" HorizontalOptions="FillAndExpand"></Button>
                                                            </StackLayout>
                                                        </StackLayout>

                                                    </border:SfBorder>

                                                </StackLayout>


                                            </ViewCell>
                                        </DataTemplate>
                                    </sflistview:SfListView.ItemTemplate>
                                </sflistview:SfListView>

                            </Grid>


                        </Grid>


                    </StackLayout>



                </navigationdrawer:SfNavigationDrawer.ContentView>
                <navigationdrawer:SfNavigationDrawer.DrawerHeaderView>
                    <StackLayout BackgroundColor="#faf8f8" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Image Source="BMFlogoTransp.png" IsVisible="{Binding ShowLogin}" WidthRequest="180" Margin="0,60,0,0"></Image>
                        <Frame IsVisible="{Binding ShowLogout}" Margin="0,50,0,0" CornerRadius="50" BorderColor="#faf8f8"
           HeightRequest="100"
           WidthRequest="100"
           HorizontalOptions="Center"
           Padding="0"
           HasShadow="False"
           IsClippedToBounds="True">
                            <ffimageloading:CachedImage LoadingPlaceholder="NoImage.png" FadeAnimationForCachedImages="True" BackgroundColor="Gray" Aspect="Fill" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Source="{Binding Profile.Photo_URL}"></ffimageloading:CachedImage>
                        </Frame>

                        <Label IsVisible="{Binding ShowLogout}" HorizontalOptions="Center" VerticalOptions="End" TextColor="Black" FontFamily="MontserratBold" FontSize="Medium" Margin="10,10,0,0" Text="{Binding Profile.FullName}"></Label>


                    </StackLayout>
                </navigationdrawer:SfNavigationDrawer.DrawerHeaderView>

                <navigationdrawer:SfNavigationDrawer.DrawerContentView >
                    <!-- Custom Control to display Menu Bound to MainMenuPageViewModel -->
                    <local:MainMenu Menu="{Binding MenuVM}"></local:MainMenu>
                </navigationdrawer:SfNavigationDrawer.DrawerContentView>
                <navigationdrawer:SfNavigationDrawer.DrawerFooterView>
                    <Grid BackgroundColor="#faf8f8">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <Label Text="Bahrain Motor Federation" FontSize="Micro" TextColor="Black" VerticalOptions="End" HorizontalOptions="Center" ></Label>
                        </StackLayout>
                    </Grid>
                </navigationdrawer:SfNavigationDrawer.DrawerFooterView>
            </navigationdrawer:SfNavigationDrawer>


        </StackLayout>

        <BoxView Color="Black" IsVisible="{Binding IsBusy}" Opacity="0.5" AbsoluteLayout.LayoutBounds="0, 0, 1, 1" AbsoluteLayout.LayoutFlags="All" />
        <StackLayout IsVisible="{Binding IsBusy}" Padding="6" Orientation="Vertical" AbsoluteLayout.LayoutBounds="0.5, 0.5, -1, -1" AbsoluteLayout.LayoutFlags="PositionProportional">
            <Syncfusion:SfBusyIndicator
				IsBusy="{Binding IsBusy}" Title="Please Wait ..."
				TextColor="White" TextSize="12"
				VerticalOptions="Center"
				HorizontalOptions="Center"
				WidthRequest="100" HeightRequest="100"
				AnimationType="SingleCircle  ">
            </Syncfusion:SfBusyIndicator>
        </StackLayout>
    </AbsoluteLayout>

</ContentPage>