<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:prism="http://prismlibrary.com" xmlns:Syncfusion="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms" xmlns:navigationdrawer="clr-namespace:Syncfusion.SfNavigationDrawer.XForms;assembly=Syncfusion.SfNavigationDrawer.XForms" xmlns:local="clr-namespace:BMF_NewApp.Views" xmlns:ffimageloading="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms" xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms" xmlns:carousel="clr-namespace:Syncfusion.SfCarousel.XForms;assembly=Syncfusion.SfCarousel.XForms" xmlns:sflistview="clr-namespace:Syncfusion.ListView.XForms;assembly=Syncfusion.SfListView.XForms"
             prism:ViewModelLocator.AutowireViewModel="True" NavigationPage.HasNavigationBar="false"
             Title="{Binding Title}" BackgroundColor="#f5f5f5"
             x:Class="BMF_NewApp.Views.MyLicensePage">
    <AbsoluteLayout Padding="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <StackLayout AbsoluteLayout.LayoutBounds="0, 0, 1, 1" AbsoluteLayout.LayoutFlags="All" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

            <navigationdrawer:SfNavigationDrawer x:Name="navigationDrawer" DrawerHeaderHeight="200" DrawerWidth ="300" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" DrawerFooterHeight="30">
                <navigationdrawer:SfNavigationDrawer.ContentView>
                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid x:Name="mainContentView" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="60"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackLayout Grid.Row="0" BackgroundColor="#D90000" Orientation="Horizontal">
                                <Grid HorizontalOptions="FillAndExpand" Padding="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Margin="0,30,0,0" Grid.Column="0" x:Name="hamburgerButton" HeightRequest="50" WidthRequest="50" HorizontalOptions="Start" FontSize="20" BackgroundColor="#D90000" Image="burgerIcon" Clicked="hamburgerButton_Clicked"/>
                                    <Button Grid.Column="2" Command="{prism:NavigateTo 'MyLicensePage'}" VerticalOptions="End" Margin="0,20,20,0" Text="License" FontSize="Small" FontFamily="MontserratMedium" BackgroundColor="Transparent" TextColor="White" HorizontalOptions="End"></Button>


                                </Grid>
                            </StackLayout>

                            <Grid Margin="0,-6,0,0" Padding="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="1">
                                <sflistview:SfListView  ItemsSource="{Binding MyLicenseList}"
                                                        ItemSpacing="0"
                                                        SelectionMode="Single"
                                                        SelectionBackgroundColor="Transparent"
                                                        HeaderSize="50"
                                                        ItemSize="550"
                                                        HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
                                                        Padding="0"
                                                        Margin="0">
                                    <sflistview:SfListView.HeaderTemplate>
                                        <DataTemplate>
                                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="#D90000">
                                                <Label Text="My ID" FontSize="Large" FontFamily="MontserratBold" TextColor="White" HorizontalOptions="Center" VerticalOptions="CenterAndExpand"></Label>
                                            </StackLayout>
                                        </DataTemplate>
                                    </sflistview:SfListView.HeaderTemplate>
                                    <sflistview:SfListView.Behaviors>
                                        <prism:EventToCommandBehavior EventName="ItemTapped"
                                                                    Command="{Binding CategoryTappedCommand}"
                                                                    EventArgsParameterPath="ItemData">
                                        </prism:EventToCommandBehavior>
                                    </sflistview:SfListView.Behaviors>
                                    <sflistview:SfListView.ItemTemplate>
                                        <DataTemplate>
                                            <ViewCell>
                                                <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="StartAndExpand" Margin="0">


                                                    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <border:SfBorder HeightRequest="280" Grid.Row="0" Margin="0" Padding="0" CornerRadius="10" BorderColor="LightGray" BorderWidth="3" BackgroundColor="White"
                                     HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsClippedToBounds="True">
                                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="Start">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>

                                                                <Image Aspect="Fill" HeightRequest="280" BackgroundColor="White" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Source="{Binding LicenseType.Image_Front_URL}" Grid.Row="0"/>

                                                                <Grid Grid.Row="0" VerticalOptions="Center" Margin="0,10,0,0" HorizontalOptions="FillAndExpand">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="100"/>
                                                                        <ColumnDefinition/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackLayout Margin="10,0,0,0" Grid.Column="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                                        <Image Aspect="Fill" HeightRequest="100" Source="{Binding Profile.Photo_URL}"></Image>
                                                                    </StackLayout>

                                                                    <StackLayout Grid.Column="1" VerticalOptions="Center">
                                                                        <Label HorizontalOptions="Center" FontFamily="MontserratMedium" VerticalOptions="Center" Text="{Binding License_Number, StringFormat='LICENSE NO: {0}'}" TextColor="Black" FontSize="Small"/>
                                                                        <Label HorizontalOptions="Center" FontFamily="MontserratMedium" VerticalOptions="Center" Text="{Binding Profile.Blood_Group, StringFormat='BLOOD GROUP: {0}'}" TextColor="Black" FontSize="Small"/>
                                                                        <Label HorizontalOptions="Center" FontFamily="MontserratMedium" VerticalOptions="Center" Text="{Binding Profile.DateOfBirth, StringFormat='DOB: {0:dd MMM yyyy}'}" TextColor="Black" FontSize="Small"/>
                                                                        <Label HorizontalOptions="Center" FontFamily="MontserratMedium" VerticalOptions="Center" Text="{Binding Expire_Date, StringFormat='EXPIRY DATE: {0:dd MMM yyyy}'}" TextColor="Black" FontSize="Small"/>
                                                                    </StackLayout>
                                                                </Grid>

                                                                <StackLayout Grid.Row="0" VerticalOptions="End" Margin="20,10,0,0" HorizontalOptions="FillAndExpand">
                                                                    <Label HorizontalOptions="Start" FontFamily="MontserratBold" VerticalOptions="Center" Text="{Binding Profile.FullName, StringFormat='NAME: {0}'}" Margin="0,5,0,0" TextColor="Black" FontSize="Small"/>
                                                                    <Label HorizontalOptions="Start" FontFamily="MontserratBold" VerticalOptions="Center" Text="{Binding LicenseType.LicenseTitleFull}" TextColor="Red" FontSize="Small" Margin="0,-5,0,0"/>
                                                                </StackLayout>
                                                            </Grid>

                                                        </border:SfBorder>


                                                    </Grid>


                                                </StackLayout>
                                            </ViewCell>
                                        </DataTemplate>
                                    </sflistview:SfListView.ItemTemplate>
                                </sflistview:SfListView>

                            </Grid>


                        </Grid>


                    </StackLayout>



                </navigationdrawer:SfNavigationDrawer.ContentView>
                <navigationdrawer:SfNavigationDrawer.DrawerHeaderView>
                    <StackLayout BackgroundColor="#faf8f8" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Image Source="BMFlogoTransp.png" IsVisible="{Binding ShowLogin}" WidthRequest="180" Margin="0,60,0,0"></Image>
                        <Frame IsVisible="{Binding ShowLogout}" Margin="0,50,0,0" CornerRadius="50" BorderColor="#faf8f8"
           HeightRequest="100"
           WidthRequest="100"
           HorizontalOptions="Center"
           Padding="0"
           HasShadow="False"
           IsClippedToBounds="True">
                            <ffimageloading:CachedImage LoadingPlaceholder="NoImage.png" FadeAnimationForCachedImages="True" BackgroundColor="Gray" Aspect="Fill" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Source="{Binding Profile.Photo_URL}"></ffimageloading:CachedImage>
                        </Frame>

                        <Label IsVisible="{Binding ShowLogout}" HorizontalOptions="Center" VerticalOptions="End" TextColor="Black" FontFamily="MontserratBold" FontSize="Medium" Margin="10,10,0,0" Text="{Binding Profile.FullName}"></Label>


                    </StackLayout>
                </navigationdrawer:SfNavigationDrawer.DrawerHeaderView>

                <navigationdrawer:SfNavigationDrawer.DrawerContentView >
                    <!-- Custom Control to display Menu Bound to MainMenuPageViewModel -->
                    <local:MainMenu Menu="{Binding MenuVM}"></local:MainMenu>
                </navigationdrawer:SfNavigationDrawer.DrawerContentView>
                <navigationdrawer:SfNavigationDrawer.DrawerFooterView>
                    <Grid BackgroundColor="#faf8f8">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <Label Text="Bahrain Motor Federation" FontSize="Micro" TextColor="Black" VerticalOptions="End" HorizontalOptions="Center" ></Label>
                        </StackLayout>
                    </Grid>
                </navigationdrawer:SfNavigationDrawer.DrawerFooterView>
            </navigationdrawer:SfNavigationDrawer>


        </StackLayout>

        <BoxView Color="Black" IsVisible="{Binding IsBusy}" Opacity="0.5" AbsoluteLayout.LayoutBounds="0, 0, 1, 1" AbsoluteLayout.LayoutFlags="All" />
        <StackLayout IsVisible="{Binding IsBusy}" Padding="6" Orientation="Vertical" AbsoluteLayout.LayoutBounds="0.5, 0.5, -1, -1" AbsoluteLayout.LayoutFlags="PositionProportional">
            <Syncfusion:SfBusyIndicator
				IsBusy="{Binding IsBusy}" Title="Please Wait ..."
				TextColor="White" TextSize="12"
				VerticalOptions="Center"
				HorizontalOptions="Center"
				WidthRequest="100" HeightRequest="100"
				AnimationType="SingleCircle  ">
            </Syncfusion:SfBusyIndicator>
        </StackLayout>
    </AbsoluteLayout>

</ContentPage>