<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:Syncfusion="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms" 
             xmlns:navigationdrawer="clr-namespace:Syncfusion.SfNavigationDrawer.XForms;assembly=Syncfusion.SfNavigationDrawer.XForms" 
             xmlns:local="clr-namespace:BMF_NewApp.Views" xmlns:ffimageloading="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms" 
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms" 
             xmlns:combobox="clr-namespace:Syncfusion.XForms.ComboBox;assembly=Syncfusion.SfComboBox.XForms"
             x:Class="BMF_NewApp.Views.MainPage"  NavigationPage.HasNavigationBar="false"
             Title="{Binding Title}" BackgroundColor="#f5f5f5">

    <AbsoluteLayout Padding="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <StackLayout AbsoluteLayout.LayoutBounds="0, 0, 1, 1" AbsoluteLayout.LayoutFlags="All" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

            <navigationdrawer:SfNavigationDrawer x:Name="navigationDrawer" DrawerHeaderHeight="200" DrawerWidth ="300" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" DrawerFooterHeight="30">
                <navigationdrawer:SfNavigationDrawer.ContentView>
                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid x:Name="mainContentView" HorizontalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="90"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackLayout Grid.Row="0" BackgroundColor="#f5f5f5" Orientation="Horizontal">
                                <Grid HorizontalOptions="FillAndExpand" Padding="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Margin="0,30,0,0" Grid.Column="0" x:Name="hamburgerButton" HeightRequest="50" WidthRequest="50" HorizontalOptions="Start" FontSize="20" BackgroundColor="#f5f5f5" Image="burgerIcon" Clicked="hamburgerButton_Clicked"/>

                                </Grid>
                            </StackLayout>

                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="1">
                                <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                    <ScrollView.Content>
                                        <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                            <Grid IsVisible="{Binding IsLoggedIn}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="20">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                                    <ColumnDefinition Width="70"></ColumnDefinition>
                                                </Grid.ColumnDefinitions>

                                                <Label Grid.Column="0" VerticalOptions="Center" FontFamily="MontserratBold" FontSize="Large" TextColor="Black" Text="{Binding Dashboard.Profile.FullName, StringFormat='Hi, {0}'}"></Label>

                                                <Frame Grid.Column="1" CornerRadius="35" BorderColor="#faf8f8"
           HeightRequest="70"
           WidthRequest="70"
           HorizontalOptions="Start"
           Padding="0" HasShadow="False"
           IsClippedToBounds="True">
                                                    <ffimageloading:CachedImage LoadingPlaceholder="bmcLogo.png" FadeAnimationForCachedImages="True" BackgroundColor="Gray" Aspect="Fill" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Source="{Binding Dashboard.Profile.Photo_URL}"></ffimageloading:CachedImage>
                                                </Frame>
                                            </Grid>

                                            <border:SfBorder Margin="20" HeightRequest="140"
   BorderColor="White"
   BackgroundColor="White" 
   HorizontalOptions="FillAndExpand" 
   VerticalOptions="FillAndExpand"
   BorderWidth="0" CornerRadius="10">

                                                <StackLayout Margin="0">
                                                    <StackLayout Margin="0" HeightRequest="50" BackgroundColor="#D90000">
                                                        <Label TextColor="White" FontSize="Medium" Margin="20,13,0,0" FontFamily="MontserratMedium" Text="{Binding Countdown.EventFullName, StringFormat='Next Round: {0}'}"></Label>
                                                    </StackLayout>

                                                    <StackLayout Margin="20,0,20,0" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                                                        <Grid Margin="0,10,0,0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <Label Grid.Column="0" Grid.Row="0" HorizontalOptions="Center" FontSize="25" TextColor="Black" FontFamily="MontserratBold" Text="{Binding Countdown.Day}"></Label>
                                                            <Label Grid.Column="1" Grid.Row="0" HorizontalOptions="Center" FontSize="25" TextColor="Black" FontFamily="MontserratBold" Text="{Binding Countdown.Hour}"></Label>
                                                            <Label Grid.Column="2" Grid.Row="0" HorizontalOptions="Center" FontSize="25" TextColor="Black" FontFamily="MontserratBold" Text="{Binding Countdown.Min}"></Label>
                                                            <Label Grid.Column="3" Grid.Row="0" HorizontalOptions="Center" FontSize="25" TextColor="Black" FontFamily="MontserratBold" Text="{Binding Countdown.Sec}"></Label>

                                                            <Label Grid.Column="0" Grid.Row="1" HorizontalOptions="Center" FontSize="12" TextColor="Black" FontFamily="MontserratLight" Text="DAYS"></Label>
                                                            <Label Grid.Column="1" Grid.Row="1" HorizontalOptions="Center" FontSize="12" TextColor="Black" FontFamily="MontserratLight" Text="HOURS"></Label>
                                                            <Label Grid.Column="2" Grid.Row="1" HorizontalOptions="Center" FontSize="12" TextColor="Black" FontFamily="MontserratLight" Text="MINUTS"></Label>
                                                            <Label Grid.Column="3" Grid.Row="1" HorizontalOptions="Center" FontSize="12" TextColor="Black" FontFamily="MontserratLight" Text="SECONDS"></Label>

                                                        </Grid>
                                                    </StackLayout>
                                                </StackLayout>
                                            </border:SfBorder>

                                            <Label TextColor="Black" Margin="20,20,20,0" Text="Upcoming Events" FontFamily="MontserratBold" FontSize="Title"></Label>
                                            <BoxView Margin="20,0,0,0" HeightRequest="5" BackgroundColor="#D90000" HorizontalOptions="FillAndExpand"></BoxView>                                            
                                            
                                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" HeightRequest="260" Margin="20,10,20,0">
                                                <CarouselView ItemsSource="{Binding ComingEventsList}" BackgroundColor="Transparent" HeightRequest="250">
                                                    <CarouselView.ItemsLayout>
                                                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                                                    </CarouselView.ItemsLayout>
                                                    <CarouselView.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" HeightRequest="260" Margin="20,10,20,0">
                                                                <border:SfBorder CornerRadius="10" BorderColor="White" BorderWidth="0"
                                    BackgroundColor="#E22020" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsClippedToBounds="True">
                                                                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                                        <ffimageloading:CachedImage LoadingPlaceholder="NoEventImage.png" FadeAnimationForCachedImages="True" BackgroundColor="LightGray" HeightRequest="180" Aspect="AspectFill" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Source="{Binding EventCategory.Image_URL}"></ffimageloading:CachedImage>
                                                                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackLayout Grid.Column="0" Margin="0,5,0,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                                                <Label Margin="20,-5,0,0" TextColor="White" Text="{Binding EventFullName}" FontFamily="MontserratMedium" FontSize="Medium"></Label>
                                                                                <Label Margin="20,-5,0,0" TextColor="White" Text="{Binding DateTime_Start, StringFormat=' {0:dd MMM yyyy}'}" FontFamily="MontserratMedium" FontSize="Small"></Label>
                                                                            </StackLayout>
                                                                        </Grid>
                                                                    </StackLayout>
                                                                </border:SfBorder>

                                                            </StackLayout>
                                                        </DataTemplate>
                                                    </CarouselView.ItemTemplate>
                                                </CarouselView>
                                            </StackLayout>


                                            <Label TextColor="Black" Margin="20,20,20,0" Text="Latest News" FontFamily="MontserratBold" FontSize="Title"></Label>
                                            <BoxView Margin="20,0,0,0" HeightRequest="5" BackgroundColor="#D90000" HorizontalOptions="FillAndExpand"></BoxView>

                                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" HeightRequest="390" Margin="20,10,20,0">
                                                <CarouselView ItemsSource="{Binding NewsList}" BackgroundColor="Transparent" HeightRequest="390">
                                                    <CarouselView.ItemsLayout>
                                                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                                                    </CarouselView.ItemsLayout>
                                                    <CarouselView.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" HeightRequest="390" Margin="20,10,20,0">
                                                                <border:SfBorder CornerRadius="10" BorderColor="White" BorderWidth="0"
                                    BackgroundColor="White" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsClippedToBounds="True">
                                                                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                                        <ffimageloading:CachedImage LoadingPlaceholder="NoEventImage.png" FadeAnimationForCachedImages="True" BackgroundColor="LightGray" HeightRequest="150" Aspect="AspectFill" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Source="{Binding Image_URL}"></ffimageloading:CachedImage>
                                                                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackLayout Grid.Column="0" Margin="0,5,0,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                                                <Label Margin="20,-5,0,0" TextColor="Black" Text="{Binding Title}" FontFamily="MontserratBold" FontSize="Large"></Label>
                                                                                <Label Margin="20,-5,20,0" TextColor="Black" Text="{Binding ContentCard}" FontFamily="MontserratLight" FontSize="Small"></Label>
                                                                            </StackLayout>
                                                                        </Grid>
                                                                    </StackLayout>
                                                                </border:SfBorder>


                                                            </StackLayout>
                                                        </DataTemplate>
                                                    </CarouselView.ItemTemplate>
                                                </CarouselView>
                                                

                                            </StackLayout>


                                            <Grid HorizontalOptions="FillAndExpand">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                                    <ColumnDefinition Width="150"></ColumnDefinition>
                                                </Grid.ColumnDefinitions>

                                                <Label Grid.Column="0" TextColor="Black" Margin="20,20,20,0" Text="Latest Results" FontFamily="MontserratBold" FontSize="Title"></Label>
                                                <Button BackgroundColor="Transparent" HeightRequest="20" Grid.Column="1" TextColor="Black" Margin="0,0,40,5" VerticalOptions="End" HorizontalOptions="End" Text="See all" FontFamily="MontserratMedium" FontSize="Medium"></Button>
                                                <Image Grid.Column="1" Source="ArrowSmallIcon" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,20,8"></Image>
                                            </Grid>
                                            
                                            <BoxView Margin="20,0,0,0" HeightRequest="5" BackgroundColor="#D90000" HorizontalOptions="FillAndExpand"></BoxView>

                                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                <Grid HorizontalOptions="FillAndExpand" Margin="20,0,20,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="60"></RowDefinition>
                                                        <RowDefinition Height="100"></RowDefinition>
                                                    </Grid.RowDefinitions>

                                                    <border:SfBorder Grid.Row="1" CornerRadius="10" BorderColor="White" BorderWidth="0"
                                    BackgroundColor="White" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsClippedToBounds="True">
                                                        <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                            <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="50"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackLayout Grid.Column="0" Margin="0,15,0,0" HorizontalOptions="FillAndExpand" VerticalOptions="Center">
                                                                    <Label Margin="20,-5,0,0" TextColor="Black" Text="Event Full Name Round 1" FontFamily="MontserratMedium" FontSize="Medium"></Label>
                                                                    <Label Margin="20,-5,0,0" TextColor="Gray" Text="02 Feb 2021" FontFamily="MontserratMedium" FontSize="Small"></Label>
                                                                </StackLayout>

                                                                <StackLayout Grid.Column="1" Margin="0,5,0,0" HorizontalOptions="FillAndExpand" VerticalOptions="Center">
                                                                    <Image Source="ArrowLargeIcon" HorizontalOptions="Center" VerticalOptions="Center"></Image>
                                                                </StackLayout>
                                                            </Grid>
                                                        </StackLayout>
                                                    </border:SfBorder>

                                                    
                                                    <border:SfBorder Grid.RowSpan="2" HasShadow="True" Margin="20,30,0,0" Grid.Row="0" CornerRadius="10" BorderColor="White" BorderWidth="0"
                                    BackgroundColor="White" WidthRequest="60" HeightRequest="60" HorizontalOptions="Start" VerticalOptions="Start" IsClippedToBounds="True">
                                                        <StackLayout WidthRequest="60" HeightRequest="60" VerticalOptions="Start" HorizontalOptions="Start">
                                                            <Label TextColor="#F72828" FontFamily="MontserratMedium" FontSize="Large" Margin="0,5,0,0" Text="23" HorizontalOptions="Center"></Label>
                                                            <Label TextColor="Black" FontFamily="MontserratMedium" FontSize="Medium" Text="FEB" Margin="0,-5,0,0" HorizontalOptions="Center"></Label>
                                                        </StackLayout>
                                                    </border:SfBorder>


                                                </Grid>

                                            </StackLayout>

                                        </StackLayout>
                                    </ScrollView.Content>
                                </ScrollView>


                            </StackLayout>
                        </Grid>


                    </StackLayout>



                </navigationdrawer:SfNavigationDrawer.ContentView>
                <navigationdrawer:SfNavigationDrawer.DrawerHeaderView>
                    <StackLayout BackgroundColor="#faf8f8" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Image Source="BMF_logo.png" WidthRequest="180" Margin="0,60,0,0"></Image>
                        <Frame IsVisible="{Binding IsLoggedIn}" Margin="0,50,0,0" CornerRadius="50" BorderColor="#faf8f8"
           HeightRequest="100"
           WidthRequest="100"
           HorizontalOptions="Center"
           Padding="0"
           HasShadow="False"
           IsClippedToBounds="True">
                            <ffimageloading:CachedImage LoadingPlaceholder="bmcLogo.png" FadeAnimationForCachedImages="True" BackgroundColor="Gray" Aspect="Fill" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Source="{Binding Dashboard.Profile.Photo_URL}"></ffimageloading:CachedImage>
                        </Frame>

                        <Label IsVisible="{Binding IsLoggedIn}" HorizontalOptions="Center" VerticalOptions="End" TextColor="Black" FontFamily="MontserratBold" FontSize="Medium" Margin="10,10,0,0" Text="{Binding Dashboard.Profile.FullName}"></Label>


                    </StackLayout>
                </navigationdrawer:SfNavigationDrawer.DrawerHeaderView>

                <navigationdrawer:SfNavigationDrawer.DrawerContentView >
                    <!-- Custom Control to display Menu Bound to MainMenuPageViewModel -->
                    <local:MainMenu Menu="{Binding MenuVM}"></local:MainMenu>
                </navigationdrawer:SfNavigationDrawer.DrawerContentView>
                <navigationdrawer:SfNavigationDrawer.DrawerFooterView>
                    <Grid BackgroundColor="#faf8f8">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <Label Text="Bahrain Motor Federation" FontSize="Micro" TextColor="Black" VerticalOptions="End" HorizontalOptions="Center" ></Label>
                        </StackLayout>
                    </Grid>
                </navigationdrawer:SfNavigationDrawer.DrawerFooterView>
            </navigationdrawer:SfNavigationDrawer>


        </StackLayout>

        <BoxView Color="Black" IsVisible="{Binding IsBusy}" Opacity="0.5" AbsoluteLayout.LayoutBounds="0, 0, 1, 1" AbsoluteLayout.LayoutFlags="All" />
        <StackLayout IsVisible="{Binding IsBusy}" Padding="6" Orientation="Vertical" AbsoluteLayout.LayoutBounds="0.5, 0.5, -1, -1" AbsoluteLayout.LayoutFlags="PositionProportional">
            <Syncfusion:SfBusyIndicator
				IsBusy="{Binding IsBusy}" Title="Please Wait ..."
				TextColor="White" TextSize="12"
				VerticalOptions="Center"
				HorizontalOptions="Center"
				WidthRequest="100" HeightRequest="100"
				AnimationType="SingleCircle  ">
            </Syncfusion:SfBusyIndicator>
        </StackLayout>
    </AbsoluteLayout>


</ContentPage>