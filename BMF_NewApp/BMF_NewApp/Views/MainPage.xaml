<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:Syncfusion="clr-namespace:Syncfusion.SfBusyIndicator.XForms;assembly=Syncfusion.SfBusyIndicator.XForms" 
             xmlns:navigationdrawer="clr-namespace:Syncfusion.SfNavigationDrawer.XForms;assembly=Syncfusion.SfNavigationDrawer.XForms" 
             xmlns:local="clr-namespace:BMF_NewApp.Views" xmlns:ffimageloading="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms" 
             xmlns:border="clr-namespace:Syncfusion.XForms.Border;assembly=Syncfusion.Core.XForms" 
             xmlns:combobox="clr-namespace:Syncfusion.XForms.ComboBox;assembly=Syncfusion.SfComboBox.XForms" xmlns:carousel="clr-namespace:Syncfusion.SfCarousel.XForms;assembly=Syncfusion.SfCarousel.XForms" xmlns:prism="http://prismlibrary.com" xmlns:sfavatar="clr-namespace:Syncfusion.XForms.AvatarView;assembly=Syncfusion.Core.XForms"
             x:Class="BMF_NewApp.Views.MainPage"  NavigationPage.HasNavigationBar="false" x:Name="mainPage1"
             Title="{Binding Title}" BackgroundColor="#D90000">

    <AbsoluteLayout Padding="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <StackLayout AbsoluteLayout.LayoutBounds="0, 0, 1, 1" AbsoluteLayout.LayoutFlags="All" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

            <navigationdrawer:SfNavigationDrawer x:Name="navigationDrawer" DrawerHeaderHeight="200" DrawerWidth ="300" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" DrawerFooterHeight="30">
                <navigationdrawer:SfNavigationDrawer.ContentView>
                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Grid x:Name="mainContentView" HorizontalOptions="FillAndExpand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="80"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackLayout Grid.Row="0" BackgroundColor="#D90000" Orientation="Horizontal">
                                <Grid HorizontalOptions="FillAndExpand" Padding="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Margin="0,30,0,0" Grid.Column="0" x:Name="hamburgerButton" HeightRequest="50" WidthRequest="50" HorizontalOptions="Start" FontSize="20" BackgroundColor="#D90000" Image="burgerIcon" Clicked="hamburgerButton_Clicked"/>

                                </Grid>
                            </StackLayout>

                            <ScrollView BackgroundColor="#f5f5f5" Margin="0,-10,0,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Grid.Row="1">
                                <ScrollView.Content>
                                    <Grid>
                                        <Grid Margin="0" RowSpacing="0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="290"></RowDefinition>
                                                <RowDefinition Height="*"></RowDefinition>
                                            </Grid.RowDefinitions>

                                            <StackLayout Grid.Row="0" Margin="0" HorizontalOptions="FillAndExpand" VerticalOptions="StartAndExpand" BackgroundColor="#D90000">
                                                <Grid IsVisible="{Binding IsLoggedIn}" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="20">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                                        <ColumnDefinition Width="70"></ColumnDefinition>
                                                    </Grid.ColumnDefinitions>

                                                    <Label Grid.Column="0" VerticalOptions="Center" FontFamily="MontserratBold" FontSize="Large" TextColor="White" Text="{Binding Dashboard.Profile.FullName, StringFormat='Hi, {0}'}"></Label>


                                                    <sfavatar:SfAvatarView BorderColor="#D90000" BorderThickness="0" Grid.Column="1" ContentType="Custom" AvatarColorMode="LightBackground" ImageSource="{Binding Dashboard.Profile.Photo_URL}"
                                                    HorizontalOptions="Start" HeightRequest="90" CornerRadius="0" WidthRequest="70" />

                                                </Grid>

                                                <border:SfBorder Margin="20,0,20,0" HeightRequest="140"
   BorderColor="White"
   BackgroundColor="White" 
   HorizontalOptions="FillAndExpand" 
   VerticalOptions="FillAndExpand"
   BorderWidth="0" CornerRadius="10">

                                                    <StackLayout Margin="0">
                                                        <StackLayout Margin="0" HeightRequest="50" BackgroundColor="#3B3B3B">
                                                            <Label TextColor="White" FontSize="Medium" Margin="20,13,0,0" FontFamily="MontserratMedium" Text="{Binding Countdown.EventFullName, StringFormat='Next Round: {0}'}"></Label>
                                                        </StackLayout>

                                                        <Grid Margin="0,10,0,0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <Label Grid.Column="0" Grid.Row="0" HorizontalOptions="Center" FontSize="25" TextColor="Black" FontFamily="MontserratBold" Text="{Binding Countdown.Day}"></Label>
                                                            <Label Grid.Column="1" Grid.Row="0" HorizontalOptions="Center" FontSize="25" TextColor="Black" FontFamily="MontserratBold" Text="{Binding Countdown.Hour}"></Label>
                                                            <Label Grid.Column="2" Grid.Row="0" HorizontalOptions="Center" FontSize="25" TextColor="Black" FontFamily="MontserratBold" Text="{Binding Countdown.Min}"></Label>
                                                            <Label Grid.Column="3" Grid.Row="0" HorizontalOptions="Center" FontSize="25" TextColor="Black" FontFamily="MontserratBold" Text="{Binding Countdown.Sec}"></Label>

                                                            <Label Grid.Column="0" Grid.Row="1" HorizontalOptions="Center" FontSize="12" TextColor="Black" FontFamily="MontserratLight" Text="DAYS"></Label>
                                                            <Label Grid.Column="1" Grid.Row="1" HorizontalOptions="Center" FontSize="12" TextColor="Black" FontFamily="MontserratLight" Text="HOURS"></Label>
                                                            <Label Grid.Column="2" Grid.Row="1" HorizontalOptions="Center" FontSize="12" TextColor="Black" FontFamily="MontserratLight" Text="MINUTS"></Label>
                                                            <Label Grid.Column="3" Grid.Row="1" HorizontalOptions="Center" FontSize="12" TextColor="Black" FontFamily="MontserratLight" Text="SECONDS"></Label>

                                                        </Grid>
                                                    </StackLayout>
                                                </border:SfBorder>

                                                <border:SfBorder Margin="0" HeightRequest="50" BorderColor="White" BackgroundColor="#f5f5f5"
                                                                   HorizontalOptions="FillAndExpand" 
                                                                   VerticalOptions="FillAndExpand"
                                                                   BorderWidth="0" CornerRadius="30,0,0,0">
                                                </border:SfBorder>
                                            </StackLayout>

                                            <StackLayout BackgroundColor="#f5f5f5" Grid.Row="1" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                <Label TextColor="Black" Margin="20,0,20,0" Text="Upcoming Events" FontFamily="MontserratBold" FontSize="Title"></Label>
                                                <BoxView Margin="20,0,0,0" HeightRequest="5" BackgroundColor="#D90000" HorizontalOptions="FillAndExpand"></BoxView>

                                                <carousel:SfCarousel Margin="20,10,0,0" HorizontalOptions="FillAndExpand" ItemHeight="360" ViewMode="Linear" ItemsSource="{Binding ComingEventsList}" 
                                                                     BackgroundColor="Transparent"
                                                                     RotationAngle="0" SelectedItemOffset="10" Offset="0.5" ScaleOffset="0">
                                                    <carousel:SfCarousel.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="20,10,0,0">
                                                                <border:SfBorder CornerRadius="10" BorderColor="White" BorderWidth="0"
                                    BackgroundColor="White" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsClippedToBounds="True">
                                                                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                                        <Grid RowSpacing="0">
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="*"></RowDefinition>
                                                                            </Grid.RowDefinitions>

                                                                            <ffimageloading:CachedImage HeightRequest="360" Grid.Row="0" LoadingPlaceholder="NoEventImage.png" FadeAnimationForCachedImages="True" BackgroundColor="LightGray" Aspect="AspectFill" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Source="{Binding EventCategory.Image_URL}">
                                                                            </ffimageloading:CachedImage>

                                                                            <Grid Grid.Row="0" HorizontalOptions="FillAndExpand" VerticalOptions="StartAndExpand">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackLayout Grid.Column="0" Margin="0,30,0,0" HorizontalOptions="FillAndExpand" VerticalOptions="Center">
                                                                                    <Label Margin="20,-5,0,0" TextColor="White" Text="{Binding EventCategory.Title}" FontFamily="MontserratBold" FontSize="Title"></Label>
                                                                                    <Label Margin="20,30,0,0" TextColor="White" Text="NEXT ROUND" FontFamily="MontserratLight" FontSize="Medium"></Label>
                                                                                    <Label Margin="20,10,0,0" TextColor="White" TextTransform="Uppercase" Text="{Binding Round_Number}" FontFamily="MontserratBold" FontSize="Large"></Label>
                                                                                    <Label Margin="20,-5,20,0" TextColor="White" Text="{Binding DateTime_Start, StringFormat=' {0:dd MMM yyyy}'}" FontFamily="MontserratLight" FontSize="Medium"></Label>
                                                                                </StackLayout>
                                                                            </Grid>



                                                                        </Grid>
                                                                        
                                                                        
                                                                    </StackLayout>
                                                                </border:SfBorder>
                                                            </StackLayout>
                                                        </DataTemplate>
                                                    </carousel:SfCarousel.ItemTemplate>
                                                </carousel:SfCarousel>

                                                <Label TextColor="Black" Margin="20,20,20,0" Text="Latest News" FontFamily="MontserratBold" FontSize="Title"></Label>
                                                <BoxView Margin="20,0,0,0" HeightRequest="5" BackgroundColor="#D90000" HorizontalOptions="FillAndExpand"></BoxView>

                                                <carousel:SfCarousel Margin="20,10,0,20" HorizontalOptions="FillAndExpand" ItemHeight="390" ViewMode="Linear" ItemsSource="{Binding NewsList}" BackgroundColor="Transparent" HeightRequest="390"
                                                                     RotationAngle="0" SelectedItemOffset="10" Offset="0.5" ScaleOffset="0">

                                                    <carousel:SfCarousel.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" HeightRequest="390" Margin="20,10,20,0">
                                                                <border:SfBorder CornerRadius="10" BorderColor="White" BorderWidth="0"
                                    BackgroundColor="White" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" IsClippedToBounds="True">
                                                                    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                                        <ffimageloading:CachedImage LoadingPlaceholder="NoEventImage.png" FadeAnimationForCachedImages="True" BackgroundColor="LightGray" HeightRequest="150" Aspect="AspectFill" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Source="{Binding Image_URL}">
                                                                        </ffimageloading:CachedImage>
                                                                        <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackLayout Grid.Column="0" Margin="0,5,0,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                                                                <Label Margin="20,-5,0,0" TextColor="Black" Text="{Binding Title}" FontFamily="MontserratBold" FontSize="Large"></Label>
                                                                                <Label Margin="20,-5,20,0" TextColor="Black" Text="{Binding ContentCard}" FontFamily="MontserratLight" FontSize="Small"></Label>

                                                                                <Button HorizontalOptions="End" Text="Press here for more" Margin="0,10,20,0" TextColor="#D90000" FontSize="Small" FontFamily="MontserratBold" BackgroundColor="Transparent"
                                                                                        Command="{Binding Path=BindingContext.NewsCommand, Source={x:Reference Name=mainPage1}}" CommandParameter="{Binding .}"></Button>
                                                                            </StackLayout>
                                                                        </Grid>
                                                                    </StackLayout>
                                                                </border:SfBorder>


                                                            </StackLayout>
                                                        </DataTemplate>
                                                    </carousel:SfCarousel.ItemTemplate>
                                                </carousel:SfCarousel>
                                            </StackLayout>

                                        </Grid>

                                    </Grid>
                                </ScrollView.Content>
                            </ScrollView>

                        </Grid>
                    </StackLayout>

                </navigationdrawer:SfNavigationDrawer.ContentView>
                <navigationdrawer:SfNavigationDrawer.DrawerHeaderView>
                    <StackLayout BackgroundColor="#faf8f8" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                        <Image Source="BMFlogoTransp.png" IsVisible="{Binding ShowLogin}" WidthRequest="180" Margin="0,60,0,0"></Image>

                        <sfavatar:SfAvatarView BorderColor="White" IsVisible="{Binding ShowLogout}" Grid.Column="1" IsClippedToBounds="True" ContentType="Custom" AvatarColorMode="LightBackground" ImageSource="{Binding Dashboard.Profile.Photo_URL}"
                                                    Margin="0,50,0,0" HorizontalOptions="Center" HeightRequest="100" WidthRequest="100" />

                        <Label IsVisible="{Binding ShowLogout}" HorizontalOptions="Center" VerticalOptions="End" TextColor="Black" FontFamily="MontserratBold" FontSize="Medium" Margin="10,10,0,0" Text="{Binding Dashboard.Profile.FullName}"></Label>


                    </StackLayout>
                </navigationdrawer:SfNavigationDrawer.DrawerHeaderView>

                <navigationdrawer:SfNavigationDrawer.DrawerContentView >
                    <!-- Custom Control to display Menu Bound to MainMenuPageViewModel -->
                    <local:MainMenu Menu="{Binding MenuVM}"></local:MainMenu>
                </navigationdrawer:SfNavigationDrawer.DrawerContentView>
                <navigationdrawer:SfNavigationDrawer.DrawerFooterView>
                    <Grid BackgroundColor="#faf8f8">
                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                            <Label Text="Bahrain Motor Federation" FontSize="Micro" TextColor="Black" VerticalOptions="End" HorizontalOptions="Center" ></Label>
                        </StackLayout>
                    </Grid>
                </navigationdrawer:SfNavigationDrawer.DrawerFooterView>
            </navigationdrawer:SfNavigationDrawer>


        </StackLayout>

        <BoxView Color="Black" IsVisible="{Binding IsBusy}" Opacity="0.5" AbsoluteLayout.LayoutBounds="0, 0, 1, 1" AbsoluteLayout.LayoutFlags="All" />
        <StackLayout IsVisible="{Binding IsBusy}" Padding="6" Orientation="Vertical" AbsoluteLayout.LayoutBounds="0.5, 0.5, -1, -1" AbsoluteLayout.LayoutFlags="PositionProportional">
            <Syncfusion:SfBusyIndicator
				IsBusy="{Binding IsBusy}" Title="Please Wait ..."
				TextColor="White" TextSize="12"
				VerticalOptions="Center"
				HorizontalOptions="Center"
				WidthRequest="100" HeightRequest="100"
				AnimationType="SingleCircle  ">
            </Syncfusion:SfBusyIndicator>
        </StackLayout>
    </AbsoluteLayout>


</ContentPage>